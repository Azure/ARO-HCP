{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "SRE view of customer HCP cluster-autoscaler main-loop activity staleness. Highlights HCPs with no main activity for at least five minutes, for investigation related to ITN-2026-00313.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "### Cluster Autoscaler Staleness\n\nLists customer HCPs where the cluster-autoscaler `main` activity metric is at least **5 minutes** old. Each table is backed by one HCP Prometheus datasource; use the Data Source selector to focus on a region. No rows means no matching stale activity was found in the selected datasources.\n\nThis dashboard supports investigation related to **ITN-2026-00313**. For follow-up steps, see the [temporary cluster-autoscaler troubleshooting guide](https://github.com/Azure/ARO-HCP/blob/main/docs/ops/temporary-cluster-autoscaler-override.md).",
        "mode": "markdown"
      },
      "pluginVersion": "11.6.9",
      "title": "About this dashboard",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Current seconds since the cluster-autoscaler last reported main activity. Rows are limited to values at or above 300 seconds.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "mode": "basic",
              "type": "color-background"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 120
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": true,
          "enablePagination": true,
          "fields": "",
          "reducer": [
            "count"
          ],
          "show": true
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Seconds Since Main Activity"
          }
        ]
      },
      "pluginVersion": "11.6.9",
      "repeat": "datasource",
      "repeatDirection": "v",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(time() - max by (namespace, _id) (cluster_autoscaler_last_activity{activity=\"main\", job=~\".*/cluster-autoscaler$\"})) >= 300",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Stale autoscaler activity — $datasource",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "indexByName": {
              "namespace": 0,
              "_id": 1,
              "Value": 2
            },
            "renameByName": {
              "Value": "Seconds Since Main Activity",
              "_id": "HCP ID",
              "namespace": "HCP Namespace"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "preload": false,
  "refresh": "1m",
  "schemaVersion": 41,
  "tags": [
    "sre",
    "cluster-health",
    "cluster-autoscaler",
    "incident-response"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "^Managed_Prometheus_hcps-(?![a-z]{2,3}$).+$",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "uid": "sre-ca-main-activity-staleness",
  "version": 1
}
