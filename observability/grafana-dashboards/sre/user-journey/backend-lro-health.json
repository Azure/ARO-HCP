    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "id": 10,
      "title": "Multi-Window Burn Rate Comparison",
      "type": "row"
    },
    {
      "datasource": { "type": "datasource", "uid": "-- Mixed --" },
      "description": "Error rate and completed-operation volume side-by-side across all three windows per Resource/Verb pair, independent of the SLO Window selector above. Terminal Ops is total completed operations (succeeded + failed) in the window; Failed is the subset that failed; both give the volume behind the error rate.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" }
          },
          "decimals": 2,
          "mappings": [],
          "unit": "percentunit"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*(Ops|Failed)" },
            "properties": [
              { "id": "unit", "value": "operations" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 150 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*Error Rate" },
            "properties": [{ "id": "custom.width", "value": 110 }]
          },
          {
            "matcher": { "id": "byName", "options": "Resource Type" },
            "properties": [{ "id": "custom.width", "value": 480 }]
          },
          {
            "matcher": { "id": "byName", "options": "Operation" },
            "properties": [{ "id": "custom.width", "value": 90 }]
          }
        ]
      },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 29 },
      "id": 11,
      "options": {
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "1h Error Rate" }]
      },
      "pluginVersion": "11.6.9",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "errors:backend_resource_operation:error_rate_1h{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "errors:backend_resource_operation:error_rate_6h{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\"}",
