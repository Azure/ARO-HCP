{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": ["user-journey"],
      "title": "Other LRO / User Journey dashboards",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false },
        "content": "LRO health from the unified metrics; covers every Resource/Verb pair. Use Resource Type / Operation Type above to drill in (all optional); use the Region selector to pick a Prometheus workspace. See related per-resource-operation dashboards above.",
        "mode": "markdown"
      },
      "pluginVersion": "11.6.9",
      "title": "Dashboard Info",
      "type": "text"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "id": 2,
      "title": "Overview (selected window: $window)",
      "type": "row"
    },
    {
      "datasource": { "type": "datasource", "uid": "-- Mixed --" },
      "description": "Terminal (succeeded + failed, canceled excluded) operations whose terminal transition landed within the selected window, summed across all matching Resource/Verb pairs. This is the exact denominator of Operation Error Rate; in-flight operations are not included here (see In-Flight Operations).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "decimals": 0,
          "mappings": [],
          "unit": "operations"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 5, "x": 0, "y": 5 },
      "id": 16,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.9",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "sum(errors:backend_resource_operation:total_$window{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Terminal Operations ({{ $window }})",
          "refId": "A"
        }
      ],
      "title": "Terminal Operations",
      "type": "stat"
    },
    {
      "datasource": { "type": "datasource", "uid": "-- Mixed --" },
      "description": "Count of failed terminal operations whose terminal transition landed within the selected window, summed across all matching Resource/Verb pairs.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent" },
              { "color": "red", "value": 1 }
            ]
          },
          "decimals": 0,
          "unit": "operations"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 5, "x": 5, "y": 5 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.9",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "sum(errors:backend_resource_operation:failed_$window{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Failed Operations ({{ $window }})",
          "refId": "A"
        }
      ],
      "title": "Failed Operations",
      "type": "stat"
    },
    {
      "datasource": { "type": "datasource", "uid": "-- Mixed --" },
      "description": "Error rate over the selected window: failed / (succeeded + failed), across whatever resource_type/operation_type scope is currently selected, within the selected Region (Prometheus workspace). Canceled operations are excluded from both the numerator and denominator.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "decimals": 2,
          "mappings": [],
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 5, "x": 10, "y": 5 },
      "id": 3,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.9",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "sum(errors:backend_resource_operation:failed_$window{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\"})\n/\nclamp_min(sum(errors:backend_resource_operation:total_$window{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\"}), 1)",
          "instant": true,
          "legendFormat": "Error Rate ({{ $window }})",
          "refId": "A"
        }
      ],
      "title": "Operation Error Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "datasource", "uid": "-- Mixed --" },
      "description": "Operations currently in a non-terminal phase (not succeeded, failed, or canceled), summed across all matching Resource/Verb pairs. Not windowed; reflects current state.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "decimals": 0,
          "mappings": [],
          "unit": "operations"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 5, "x": 15, "y": 5 },
      "id": 5,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.9",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "sum(inflight:backend_resource_operation:count{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\"}) or vector(0)",
          "instant": true,
          "legendFormat": "In-Flight Operations",
          "refId": "A"
        }
      ],
      "title": "In-Flight Operations",
      "type": "stat"
    },
    {
      "datasource": { "type": "datasource", "uid": "-- Mixed --" },
      "description": "Worst-case in-flight duration across all matching Resource/Verb pairs: how long the longest-running active operation has been in a non-terminal phase. Not windowed; reflects current state.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": [],
          "unit": "dthms"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 5 },
      "id": 6,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.9",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "max(inflight:backend_resource_operation:max_duration_seconds{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Max In-Flight Duration",
          "refId": "A"
        }
      ],
      "title": "Max In-Flight Duration",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "id": 7,
      "title": "Error Rate & Latency Trends (selected window: $window)",
      "type": "row"
    },
    {
      "datasource": { "type": "datasource", "uid": "-- Mixed --" },
      "description": "Error rate over time per Resource/Verb pair for the selected window.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never"
          },
          "decimals": 2,
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 16, "w": 12, "x": 0, "y": 12 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.6.9",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "errors:backend_resource_operation:error_rate_$window{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\"}",
          "legendFormat": "{{ resource_type }} / {{ operation_type }}",
          "refId": "A"
        }
      ],
      "title": "Error Rate Over Time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "datasource", "uid": "-- Mixed --" },
      "description": "p50/p95/p99 latency of succeeded operations for the selected window, per Resource/Verb pair.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "Duration",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "dthms"
        },
        "overrides": []
      },
      "gridPos": { "h": 16, "w": 12, "x": 12, "y": 12 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.6.9",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "latency:backend_resource_operation:p50_$window{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\", phase=\"succeeded\"}",
          "legendFormat": "p50 {{ resource_type }} / {{ operation_type }}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "latency:backend_resource_operation:p95_$window{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\", phase=\"succeeded\"}",
          "legendFormat": "p95 {{ resource_type }} / {{ operation_type }}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "latency:backend_resource_operation:p99_$window{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\", phase=\"succeeded\"}",
          "legendFormat": "p99 {{ resource_type }} / {{ operation_type }}",
          "refId": "C"
        }
