          "legendFormat": "",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "errors:backend_resource_operation:error_rate_3d{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "errors:backend_resource_operation:total_1h{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "D"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "errors:backend_resource_operation:total_6h{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "E"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "errors:backend_resource_operation:total_3d{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "F"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "errors:backend_resource_operation:failed_1h{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "G"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "errors:backend_resource_operation:failed_6h{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "H"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "errors:backend_resource_operation:failed_3d{resource_type=~\"$resource_type\", operation_type=~\"$operation_type\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "I"
        }
      ],
      "title": "Error Rate & Volume by Window",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": { "names": ["microsoft.amwresourceid", "cluster", "region", "Time", "__name__", "environment"] }
          }
        },
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "resource_type": 0,
              "operation_type": 1,
              "Value #D": 2,
              "Value #G": 3,
              "Value #A": 4,
              "Value #E": 5,
              "Value #H": 6,
              "Value #B": 7,
              "Value #F": 8,
              "Value #I": 9,
              "Value #C": 10
            },
            "renameByName": {
              "Value #D": "1h Terminal Ops",
              "Value #G": "1h Failed",
              "Value #A": "1h Error Rate",
              "Value #E": "6h Terminal Ops",
              "Value #H": "6h Failed",
              "Value #B": "6h Error Rate",
              "Value #F": "3d Terminal Ops",
              "Value #I": "3d Failed",
              "Value #C": "3d Error Rate",
              "resource_type": "Resource Type",
              "operation_type": "Operation"
            }
          }
        }
      ],
      "type": "table"
    },
