    {
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "description": "Terminal ops, failures, error rate, and success latency percentiles per Resource/Verb pair, broken out by window (1h/6h/3d). Each window is its own row so the full golden-signal set lines up side-by-side within a row, and trend across windows reads as one row down to the next.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "decimals": 2,
          "mappings": [],
          "unit": "percentunit"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(Ops|Failed)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "operations"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error Rate"
