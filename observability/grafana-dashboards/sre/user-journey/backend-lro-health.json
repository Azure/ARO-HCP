    {
      "datasource": { "type": "datasource", "uid": "-- Mixed --" },
      "description": "Every operation currently in a non-terminal phase, sorted by Duration descending. Not windowed; reflects current state. Sourced from the raw gauges (not the aggregated recording rules), since resource_id isn't carried by those.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Resource Type" },
            "properties": [{ "id": "custom.width", "value": 480 }]
          },
          {
            "matcher": { "id": "byName", "options": "Operation" },
            "properties": [{ "id": "custom.width", "value": 90 }]
          },
          {
            "matcher": { "id": "byName", "options": "Phase" },
            "properties": [{ "id": "custom.width", "value": 130 }]
          },
          {
            "matcher": { "id": "byName", "options": "Duration" },
            "properties": [
              { "id": "custom.width", "value": 120 },
              { "id": "unit", "value": "dthms" }
            ]
          }
        ]
      },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 62 },
      "id": 15,
      "options": {
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Duration" }]
      },
      "pluginVersion": "11.6.9",
      "targets": [
        {
