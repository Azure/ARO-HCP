    {
      "datasource": { "type": "datasource", "uid": "-- Mixed --" },
      "description": "Cluster update operations in accepted or updating for over 45 minutes. This is the exact condition behind BackendAsyncOperationClusterUpdateStuck.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green" },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 5 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.6.9",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "count((time() - max without (prometheus_replica) (backend_resource_operation_start_time_seconds{resource_type=\"microsoft.redhatopenshift/hcpopenshiftclusters\", operation_type=\"update\", phase=~\"accepted|updating\"})) > 2700) or vector(0)",
          "instant": true,
          "legendFormat": "Stuck Operations",
          "refId": "A"
        }
      ],
      "title": "Stuck Operations (>45m)",
      "transformations": [
        { "id": "seriesToRows", "options": {} },
        { "id": "merge", "options": {} }
      ],
      "type": "stat"
    },
    {
      "datasource": { "type": "datasource", "uid": "-- Mixed --" },
      "description": "Remaining error budget against the 95% success-rate objective. 100% means no budget consumed; 0% means the objective is exactly met and any further failure breaches it.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "mappings": [],
