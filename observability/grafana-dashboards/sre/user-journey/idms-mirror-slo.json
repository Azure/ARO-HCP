          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 5 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.6.9",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "editorMode": "code",
          "expr": "clamp_min(\n  (1 - (\n    (count(max without (prometheus_replica) (backend_resource_operation_phase_info{resource_type=\"microsoft.redhatopenshift/hcpopenshiftclusters\", operation_type=\"update\", phase=\"failed\"})) or vector(0))\n    /\n    (count(max without (prometheus_replica) (backend_resource_operation_phase_info{resource_type=\"microsoft.redhatopenshift/hcpopenshiftclusters\", operation_type=\"update\", phase=~\"succeeded|failed\"})) > 0 or vector(1))\n  ) / 0.05) * 100,\n  0\n)",
          "instant": true,
          "legendFormat": "Error Budget Remaining",
          "refId": "A"
        }
      ],
      "title": "Error Budget Remaining (95% SLO)",
      "transformations": [
        { "id": "seriesToRows", "options": {} },
        { "id": "merge", "options": {} }
      ],
      "type": "stat"
    },
