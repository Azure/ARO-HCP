        "uid": "${datasource_svc}"
      },
      "description": "Ratio of ready to desired azure-cns DaemonSet pods on the selected management cluster. A drop indicates node-level or management-cluster-wide CNS unavailability. This is dependency-health evidence, not a customer-facing SLO.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "pluginVersion": "11.6.9",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_svc}"
          },
          "editorMode": "code",
          "expr": "cns:daemonset_availability:ratio{cluster=~\"$cluster\"}",
          "instant": true,
          "range": false,
          "legendFormat": "Availability",
          "refId": "A"
        }
      ],
      "title": "CNS DaemonSet Availability",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_svc}"
      },
      "description": "p99 latency of successful CNS secondary IP assignments on the selected management cluster. This is shared dependency-health evidence and cannot be attributed to an individual HCP. Interpret it with request volume and outcomes: failed assignments are not included in this success-only histogram.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "11.6.9",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_svc}"
          },
          "editorMode": "code",
          "expr": "cns:ip_assignment_latency:p99{cluster=~\"$cluster\"}",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "title": "CNS IP Assignment Latency p99",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_svc}"
      },
      "description": "Management-cluster-wide CNS RequestIPConfig and RequestIPConfigs API outcome rates, using CNS application return codes rather than HTTP status. Zero traffic can be normal when no router pods are being created or rescheduled. Failed requests identify the return code to investigate; this is dependency-health evidence, not a customer-facing SLO.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "id": 16,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "11.6.9",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_svc}"
          },
          "editorMode": "code",
          "expr": "sum by (cluster) (max without (prometheus_replica) (rate(http_request_latency_seconds_count{cluster=~\"$cluster\", verb=\"POST\", url=~\".*/network/requestipconfigs?.*\"}[5m])))",
          "legendFormat": "Requests received",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_svc}"
          },
          "editorMode": "code",
          "expr": "sum by (cluster, cns_return_code) (max without (prometheus_replica) (rate(http_request_latency_seconds_count{cluster=~\"$cluster\", verb=\"POST\", url=~\".*/network/requestipconfigs?.*\", cns_return_code!=\"Success\"}[5m])))",
          "legendFormat": "Failure: {{cns_return_code}}",
          "refId": "B"
        }
      ],
      "title": "CNS IP Assignment Request Outcome Rates",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_svc}"
      },
      "description": "Success ratio for CNS RequestIPConfig and RequestIPConfigs API calls, based on CNS application return codes rather than HTTP status. CNS returns HTTP 200 for application failures; Success is the explicit cns_return_code value. Use request volume and per-code rates to interpret low-volume periods. This is dependency-health evidence, not a customer-facing SLO.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
