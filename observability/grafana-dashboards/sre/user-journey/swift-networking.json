    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_svc}"
      },
      "description": "Management cluster worker nodes reporting zero advertised SWIFT NIC capacity. No series is healthy; any result means the node cannot schedule a SWIFT-backed router pod until capacity is restored or reported.",
