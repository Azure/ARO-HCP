        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "id": 13,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "11.6.9",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_svc}"
          },
          "editorMode": "code",
          "expr": "max without (prometheus_replica) (kube_node_status_capacity{job=\"kube-state-metrics\", cluster=~\"$cluster\", node=~\"user.*\", resource=\"aro_openshift_io_swift_nic\"}) == 0",
          "legendFormat": "{{cluster}} / {{node}}",
          "refId": "A"
        }
      ],
      "title": "Management Cluster Worker Nodes With Zero SWIFT NIC Capacity",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_svc}"
      },
      "description": "Difference between advertised SWIFT NIC capacity and allocatable capacity on each management cluster worker node. A non-zero value indicates a capacity-reporting inconsistency; compare the node and VMSS SKU limit before choosing remediation.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "id": 14,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "11.6.9",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_svc}"
          },
          "editorMode": "code",
          "expr": "max without (prometheus_replica) (kube_node_status_capacity{cluster=~\"$cluster\", node=~\"user.*\", resource=\"aro_openshift_io_swift_nic\"}) - on(cluster, node) max without (prometheus_replica) (kube_node_status_allocatable{cluster=~\"$cluster\", node=~\"user.*\", resource=\"aro_openshift_io_swift_nic\"})",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "SWIFT NIC Capacity vs. Allocatable Divergence",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
