          "editorMode": "code",
          "expr": "max without (prometheus_replica) (cx_pending_programming_ips_v2{cluster=~\"$cluster\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Pending IP Programming",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
