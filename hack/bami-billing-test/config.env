# BAMI billing / meter-emission test harness config. See README.md.
# Override any value by exporting it before running the scripts.
#
# READ THIS FIRST: these values decide what real, billable resources get created
# in the BAMI subscription. Before running setup.sh, deliberately review every
# value below -- especially the subscription, region, and NODEPOOL_SPECS (SKUs
# and counts) -- and make sure it is exactly what you intend to provision.

# BAMI subscription to target (an identifier, not a secret).
export BAMI_SUBSCRIPTION_ID="${BAMI_SUBSCRIPTION_ID:-efc13483-cb4e-4bf2-889a-895677f5b57c}"

# INT RP region (INT-APPROVED routes here); setup.sh validates availability.
export LOCATION="${LOCATION:-uksouth}"

# Providers prereqs.sh registers; setup.sh verifies Microsoft.RedHatOpenShift.
export REQUIRED_PROVIDERS="${REQUIRED_PROVIDERS:-Microsoft.RedHatOpenShift Microsoft.Compute Microsoft.Network Microsoft.ManagedIdentity Microsoft.Storage Microsoft.KeyVault Microsoft.Quota}"

# AFEC routing flag for INT (STG: STAGING-APPROVED; PROD: HcpPrivatePreview InProgress).
export REQUIRED_AFEC_FLAGS="${REQUIRED_AFEC_FLAGS:-INT-APPROVED}"

# Resource names ($USER-namespaced so concurrent runs don't collide).
export CUSTOMER_RG_NAME="${CUSTOMER_RG_NAME:-${USER}-bami-billing-rg}"
export CLUSTER_NAME="${CLUSTER_NAME:-${USER}-bami}"
export MANAGED_RESOURCE_GROUP="${MANAGED_RESOURCE_GROUP:-${CLUSTER_NAME}-managed-rg}"

# Customer network resource names (created inside CUSTOMER_RG_NAME).
export CUSTOMER_NSG="${CUSTOMER_NSG:-customer-nsg}"
export CUSTOMER_VNET_NAME="${CUSTOMER_VNET_NAME:-customer-vnet}"
export CUSTOMER_VNET_SUBNET1="${CUSTOMER_VNET_SUBNET1:-customer-subnet-1}"
export CUSTOMER_VNET_INTEGRATION_SUBNET="${CUSTOMER_VNET_INTEGRATION_SUBNET:-customer-vnet-integration-subnet}"

# Public etcd KeyVault by default; set true for a private KV.
export PRIVATE_KEYVAULT="${PRIVATE_KEYVAULT:-false}"

# OpenShift versions; bump if a deploy fails on an aged-out version.
export CLUSTER_VERSION="${CLUSTER_VERSION:-4.20}"
export NODEPOOL_VERSION="${NODEPOOL_VERSION:-4.20.16}"

# Node pools to create as "vmSize:replicas" specs (space-separated). Each spec
# becomes one node pool -- a node pool is single-SKU, so list several to mix SKUs
# (e.g. "Standard_D8s_v3:2 Standard_D16s_v3:1").
export NODEPOOL_SPECS="${NODEPOOL_SPECS:-Standard_E4s_v5:1 Standard_D4s_v5:1}"

# OS disk shared by all node pools.
export NODEPOOL_OSDISK_GIB="${NODEPOOL_OSDISK_GIB:-64}"
export NODEPOOL_OSDISK_TYPE="${NODEPOOL_OSDISK_TYPE:-StandardSSD_LRS}"
