{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep"
    }
  },
  "parameters": {
    "clusterName": {
      "type": "string",
      "metadata": {
        "description": "The name of the Hypershift cluster to which the node pool will be attached."
      }
    },
    "nodePoolName": {
      "type": "string",
      "metadata": {
        "description": "The name of the node pool"
      }
    },
    "nodePoolVersion": {
      "type": "string",
      "metadata": {
        "description": "The version of OpenShift to use for the node pool (e.g. 4.20.16)"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.RedHatOpenShift/hcpOpenShiftClusters/nodePools",
      "apiVersion": "2025-12-23-preview",
      "name": "[format('{0}/{1}', parameters('clusterName'), parameters('nodePoolName'))]",
      "location": "[resourceGroup().location]",
      "properties": {
        "platform": {
          "subnetId": "[reference(resourceId('Microsoft.RedHatOpenShift/hcpOpenShiftClusters', parameters('clusterName')), '2025-12-23-preview').platform.subnetId]",
          "vmSize": "Standard_D8s_v3",
          "osDisk": {
            "sizeGiB": 64,
            "diskStorageAccountType": "StandardSSD_LRS"
          }
        },
        "replicas": 2,
        "version": {
          "id": "[parameters('nodePoolVersion')]"
        }
      }
    }
  ]
}
