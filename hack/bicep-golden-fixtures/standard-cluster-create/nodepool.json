{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep"
    }
  },
  "parameters": {
    "clusterName": {
      "metadata": {
        "description": "The name of the Hypershift cluster to which the node pool will be attached."
      },
      "type": "string"
    },
    "nodePoolName": {
      "metadata": {
        "description": "The name of the node pool"
      },
      "type": "string"
    },
    "nodePoolVersion": {
      "metadata": {
        "description": "The version of OpenShift to use for the node pool (e.g. 4.20.16)"
      },
      "type": "string"
    }
  },
  "resources": [
    {
      "apiVersion": "2026-09-01-preview",
      "location": "[resourceGroup().location]",
      "name": "[format('{0}/{1}', parameters('clusterName'), parameters('nodePoolName'))]",
      "properties": {
        "platform": {
          "osDisk": {
            "diskStorageAccountType": "StandardSSD_LRS",
            "sizeGiB": 64
          },
          "subnetId": "[reference(resourceId('Microsoft.RedHatOpenShift/hcpOpenShiftClusters', parameters('clusterName')), '2026-09-01-preview').platform.subnetId]",
          "vmSize": "Standard_D8s_v3"
        },
        "replicas": 2,
        "version": {
          "id": "[parameters('nodePoolVersion')]"
        }
      },
      "type": "Microsoft.RedHatOpenShift/hcpOpenShiftClusters/nodePools"
    }
  ]
}
