{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "languageVersion": "2.0",
  "metadata": {
    "_generator": {
      "name": "bicep"
    }
  },
  "parameters": {
    "botPrincipalId": {
      "metadata": {
        "description": "Principal ID of the CI bot service principal"
      },
      "type": "string"
    },
    "grantAksRbac": {
      "defaultValue": false,
      "metadata": {
        "description": "Whether to grant AKS RBAC Cluster Admin (only needed in DEV for NSG rule management)"
      },
      "type": "bool"
    },
    "grantKeyVaultAdmin": {
      "defaultValue": false,
      "metadata": {
        "description": "Whether to grant Key Vault Administrator (data-plane secret access) on this subscription; decoupled from isGlobalSubscription so a sub can get Key Vault Admin without the other global-only roles"
      },
      "type": "bool"
    },
    "isGlobalSubscription": {
      "defaultValue": false,
      "metadata": {
        "description": "Whether this subscription hosts global infrastructure; grants the global-only data-plane roles (currently Grafana Admin)"
      },
      "type": "bool"
    }
  },
  "resources": {
    "aksRbacClusterAdminAssignment": {
      "apiVersion": "2022-04-01",
      "condition": "[parameters('grantAksRbac')]",
      "name": "[guid(subscription().id, parameters('botPrincipalId'), variables('aksRbacClusterAdminRole'))]",
      "properties": {
        "principalId": "[parameters('botPrincipalId')]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('aksRbacClusterAdminRole'))]"
      },
      "type": "Microsoft.Authorization/roleAssignments"
    },
    "contributorAssignment": {
      "apiVersion": "2022-04-01",
      "name": "[guid(subscription().id, parameters('botPrincipalId'), variables('contributorRole'))]",
      "properties": {
        "principalId": "[parameters('botPrincipalId')]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('contributorRole'))]"
      },
      "type": "Microsoft.Authorization/roleAssignments"
    },
    "grafanaAdminAssignment": {
      "apiVersion": "2022-04-01",
      "condition": "[parameters('isGlobalSubscription')]",
      "name": "[guid(subscription().id, parameters('botPrincipalId'), variables('grafanaAdminRole'))]",
      "properties": {
        "principalId": "[parameters('botPrincipalId')]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('grafanaAdminRole'))]"
      },
      "type": "Microsoft.Authorization/roleAssignments"
    },
    "keyVaultAdminAssignment": {
      "apiVersion": "2022-04-01",
      "condition": "[parameters('grantKeyVaultAdmin')]",
      "name": "[guid(subscription().id, parameters('botPrincipalId'), variables('keyVaultAdminRole'))]",
      "properties": {
        "principalId": "[parameters('botPrincipalId')]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultAdminRole'))]"
      },
      "type": "Microsoft.Authorization/roleAssignments"
    },
    "rbacAdminAssignment": {
      "apiVersion": "2022-04-01",
      "name": "[guid(subscription().id, parameters('botPrincipalId'), variables('rbacAdminRole'))]",
      "properties": {
        "condition": "[variables('restrictedRoleAssignmentCondition')]",
        "conditionVersion": "[variables('restrictedRoleAssignmentConditionVersion')]",
        "description": "CI bot: assign all roles except Owner, UAA, RBAC Administrator",
        "principalId": "[parameters('botPrincipalId')]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('rbacAdminRole'))]"
      },
      "type": "Microsoft.Authorization/roleAssignments"
    }
  },
  "variables": {
    "_1._ownerRoleDefinitionId": "8e3af657-a8ff-443c-a75c-2fe8c4bcb635",
    "_1._rbacAdminRoleDefinitionId": "f58310d9-a9f6-439a-9e8d-f62e7b41a168",
    "_1._userAccessAdminRoleDefinitionId": "18d7d88d-d35e-4fb5-a5c3-7773c20a72d9",
    "aksRbacClusterAdminRole": "b1ff04bb-8a4e-4dc4-8eb5-8693973ce19b",
    "contributorRole": "b24988ac-6180-42a0-ab88-20f7382dd24c",
    "grafanaAdminRole": "22926164-76b3-42b3-bc55-97df8dab3e41",
    "keyVaultAdminRole": "00482a5a-887f-4fb3-b363-3b7fe8e74483",
    "rbacAdminRole": "f58310d9-a9f6-439a-9e8d-f62e7b41a168",
    "restrictedRoleAssignmentCondition": "[format('((!(ActionMatches{{''Microsoft.Authorization/roleAssignments/write''}})) OR (@Request[Microsoft.Authorization/roleAssignments:RoleDefinitionId] ForAnyOfAllValues:GuidNotEquals {{{0}, {1}, {2}}})) AND ((!(ActionMatches{{''Microsoft.Authorization/roleAssignments/delete''}})) OR (@Resource[Microsoft.Authorization/roleAssignments:RoleDefinitionId] ForAnyOfAllValues:GuidNotEquals {{{3}, {4}, {5}}}))', variables('_1._ownerRoleDefinitionId'), variables('_1._userAccessAdminRoleDefinitionId'), variables('_1._rbacAdminRoleDefinitionId'), variables('_1._ownerRoleDefinitionId'), variables('_1._userAccessAdminRoleDefinitionId'), variables('_1._rbacAdminRoleDefinitionId'))]",
    "restrictedRoleAssignmentConditionVersion": "2.0"
  }
}
