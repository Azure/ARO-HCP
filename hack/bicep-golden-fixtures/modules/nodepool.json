{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep"
    }
  },
  "parameters": {
    "clusterName": {
      "type": "string",
      "metadata": {
        "description": "The name of the Hypershift cluster to which the node pool will be attached."
      }
    },
    "nodePoolName": {
      "type": "string",
      "metadata": {
        "description": "The name of the node pool"
      }
    },
    "replicas": {
      "type": "int",
      "defaultValue": 2,
      "metadata": {
        "description": "Number of replicas in the node pool"
      }
    },
    "openshiftVersionId": {
      "type": "string",
      "metadata": {
        "description": "OpenShift Version ID to use"
      }
    },
    "osDiskSizeGiB": {
      "type": "int",
      "defaultValue": 64,
      "metadata": {
        "description": "Size of the osDisk for the node pool in GiB"
      }
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_D8s_v3",
      "metadata": {
        "description": "VM size for the nodepool VMs"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.RedHatOpenShift/hcpOpenShiftClusters/nodePools",
      "apiVersion": "2024-06-10-preview",
      "name": "[format('{0}/{1}', parameters('clusterName'), parameters('nodePoolName'))]",
      "location": "[resourceGroup().location]",
      "properties": {
        "version": {
          "id": "[parameters('openshiftVersionId')]",
          "channelGroup": "stable"
        },
        "platform": {
          "subnetId": "[reference(resourceId('Microsoft.RedHatOpenShift/hcpOpenShiftClusters', parameters('clusterName')), '2024-06-10-preview').platform.subnetId]",
          "vmSize": "[parameters('vmSize')]",
          "osDisk": {
            "sizeGiB": "[parameters('osDiskSizeGiB')]",
            "diskStorageAccountType": "StandardSSD_LRS"
          }
        },
        "replicas": "[parameters('replicas')]"
      }
    }
  ]
}
