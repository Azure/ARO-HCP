{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep"
    }
  },
  "parameters": {
    "persistTagValue": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "If set to true, the cluster will not be deleted automatically after few days."
      }
    },
    "customerNsgName": {
      "type": "string",
      "defaultValue": "customer-nsg",
      "metadata": {
        "description": "Network Security Group Name"
      }
    },
    "customerVnetName": {
      "type": "string",
      "defaultValue": "customer-vnet",
      "metadata": {
        "description": "Virtual Network Name"
      }
    },
    "customerVnetSubnetName": {
      "type": "string",
      "defaultValue": "customer-subnet-1",
      "metadata": {
        "description": "Subnet Name"
      }
    },
    "customerEtcdEncryptionKeyName": {
      "type": "string",
      "defaultValue": "etcd-data-kms-encryption-key",
      "metadata": {
        "description": "The name of the encryption key for etcd"
      }
    },
    "clusterName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Cluster name used to ensure unique resource names within the resource group"
      }
    },
    "privateKeyVault": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "If set to true, creates a private KeyVault with publicNetworkAccess disabled"
      }
    },
    "assignKeyVaultCryptoOfficer": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Assign Key Vault Crypto Officer role to the deployer on the customer KeyVault that contains etcd encryption key"
      }
    },
    "enableKeyVaultSoftDelete": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable soft delete on the customer Key Vault"
      }
    },
    "enableKeyVaultPurgeProtection": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable purge protection on the customer Key Vault (requires soft delete)"
      }
    },
    "keyVaultSoftDeleteRetentionInDays": {
      "type": "int",
      "defaultValue": 7,
      "metadata": {
        "description": "Soft delete retention in days"
      }
    }
  },
  "variables": {
    "randomSuffix": "[toLower(uniqueString(resourceGroup().id, parameters('clusterName')))]",
    "customerKeyVaultName": "[format('cust-kv-{0}', variables('randomSuffix'))]",
    "addressPrefix": "10.0.0.0/16",
    "subnetPrefix": "10.0.0.0/24",
    "vnetIntegrationSubnetPrefix": "10.0.1.0/24",
    "keyVaultCryptoOfficerRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '14b46e9e-c2b7-41b4-b07b-48a6ebf60603')]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-05-01",
      "name": "[parameters('customerNsgName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "persist": "[string(parameters('persistTagValue'))]"
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-05-01",
      "name": "[parameters('customerVnetName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "persist": "[string(parameters('persistTagValue'))]"
      },
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[variables('addressPrefix')]"
          ]
        },
        "subnets": [
          {
            "name": "[parameters('customerVnetSubnetName')]",
            "properties": {
              "addressPrefix": "[variables('subnetPrefix')]",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('customerNsgName'))]"
              }
            }
          },
          {
            "name": "customer-vnet-integration-subnet",
            "properties": {
              "addressPrefix": "[variables('vnetIntegrationSubnetPrefix')]",
              "delegations": [
                {
                  "name": "aro-hcp-delegation",
                  "properties": {
                    "serviceName": "Microsoft.RedHatOpenShift/hcpOpenShiftClusters"
                  }
                }
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('customerNsgName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2024-12-01-preview",
      "name": "[variables('customerKeyVaultName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "enableRbacAuthorization": true,
        "enableSoftDelete": "[if(parameters('enableKeyVaultSoftDelete'), true(), null())]",
        "enablePurgeProtection": "[if(parameters('enableKeyVaultPurgeProtection'), true(), null())]",
        "softDeleteRetentionInDays": "[if(parameters('enableKeyVaultSoftDelete'), parameters('keyVaultSoftDeleteRetentionInDays'), null())]",
        "tenantId": "[subscription().tenantId]",
        "publicNetworkAccess": "[if(parameters('privateKeyVault'), 'Disabled', 'Enabled')]",
        "sku": {
          "family": "A",
          "name": "standard"
        }
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/keys",
      "apiVersion": "2024-12-01-preview",
      "name": "[format('{0}/{1}', variables('customerKeyVaultName'), parameters('customerEtcdEncryptionKeyName'))]",
      "properties": {
        "kty": "RSA",
        "keySize": 2048
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('customerKeyVaultName'))]"
      ]
    },
    {
      "condition": "[parameters('assignKeyVaultCryptoOfficer')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', variables('customerKeyVaultName'))]",
      "name": "[guid(resourceGroup().id, deployer().objectId, variables('keyVaultCryptoOfficerRoleId'), resourceId('Microsoft.KeyVault/vaults', variables('customerKeyVaultName')))]",
      "properties": {
        "principalId": "[deployer().objectId]",
        "principalType": "[if(and(contains(deployer(), 'userPrincipalName'), not(empty(deployer().userPrincipalName))), 'User', 'ServicePrincipal')]",
        "roleDefinitionId": "[variables('keyVaultCryptoOfficerRoleId')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('customerKeyVaultName'))]"
      ]
    },
    {
      "condition": "[parameters('privateKeyVault')]",
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "privatelink.vaultcore.azure.net",
      "location": "global",
      "properties": {},
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateEndpoints', 'kv-private-endpoint')]"
      ]
    },
    {
      "condition": "[parameters('privateKeyVault')]",
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2023-09-01",
      "name": "kv-private-endpoint",
      "properties": {
        "privateLinkServiceConnections": [
          {
            "name": "kv-private-endpoint",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.KeyVault/vaults', variables('customerKeyVaultName'))]",
              "groupIds": [
                "vault"
              ]
            }
          }
        ],
        "subnet": {
          "id": "[reference(resourceId('Microsoft.Network/virtualNetworks', parameters('customerVnetName')), '2023-05-01').subnets[0].id]"
        }
      },
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('customerKeyVaultName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', parameters('customerVnetName'))]"
      ]
    },
    {
      "condition": "[parameters('privateKeyVault')]",
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}/{1}', 'kv-private-endpoint', 'kv-private-ep-dns-group')]",
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "config1",
            "properties": {
              "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.vaultcore.azure.net')]"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones/virtualNetworkLinks', 'privatelink.vaultcore.azure.net', uniqueString('kv-private-dns-zone-link'))]",
        "[resourceId('Microsoft.Network/privateEndpoints', 'kv-private-endpoint')]",
        "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.vaultcore.azure.net')]"
      ]
    },
    {
      "condition": "[parameters('privateKeyVault')]",
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[format('{0}/{1}', 'privatelink.vaultcore.azure.net', uniqueString('kv-private-dns-zone-link'))]",
      "location": "global",
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', parameters('customerVnetName'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', parameters('customerVnetName'))]",
        "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.vaultcore.azure.net')]"
      ]
    }
  ],
  "outputs": {
    "nsgName": {
      "type": "string",
      "metadata": {
        "description": "Network Security Group Name"
      },
      "value": "[parameters('customerNsgName')]"
    },
    "vnetName": {
      "type": "string",
      "metadata": {
        "description": "Virtual Network Name"
      },
      "value": "[parameters('customerVnetName')]"
    },
    "vnetSubnetName": {
      "type": "string",
      "metadata": {
        "description": "Subnet Name"
      },
      "value": "[parameters('customerVnetSubnetName')]"
    },
    "keyVaultName": {
      "type": "string",
      "metadata": {
        "description": "Key Vault Name"
      },
      "value": "[variables('customerKeyVaultName')]"
    },
    "etcdEncryptionKeyName": {
      "type": "string",
      "metadata": {
        "description": "The name of the encryption key for etcd"
      },
      "value": "[parameters('customerEtcdEncryptionKeyName')]"
    },
    "nsgID": {
      "type": "string",
      "metadata": {
        "description": "Network Security Group Resource ID"
      },
      "value": "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('customerNsgName'))]"
    },
    "vnetSubnetID": {
      "type": "string",
      "metadata": {
        "description": "Customer VNet Subnet Resource ID"
      },
      "value": "[format('{0}/subnets/{1}', resourceId('Microsoft.Network/virtualNetworks', parameters('customerVnetName')), parameters('customerVnetSubnetName'))]"
    },
    "vnetIntegrationSubnetID": {
      "type": "string",
      "metadata": {
        "description": "Customer VNet Integration Subnet Resource ID"
      },
      "value": "[format('{0}/subnets/customer-vnet-integration-subnet', resourceId('Microsoft.Network/virtualNetworks', parameters('customerVnetName')))]"
    },
    "etcdEncryptionKeyVersion": {
      "type": "string",
      "metadata": {
        "description": "The version of the etcd encryption key"
      },
      "value": "[last(split(reference(resourceId('Microsoft.KeyVault/vaults/keys', variables('customerKeyVaultName'), parameters('customerEtcdEncryptionKeyName')), '2024-12-01-preview').keyUriWithVersion, '/'))]"
    }
  }
}
