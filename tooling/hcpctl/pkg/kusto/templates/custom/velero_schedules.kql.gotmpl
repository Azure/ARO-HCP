// Velero Schedules: snapshot history of Velero Schedule CRs captured on management clusters, for
// backup-failure debugging (ARO-28989). Mirrors veleroBackups: scoped to the mgmt cluster(s)
// hosting the HCP (ClusterNames) and pinned to the target HCP via the Azure resource-id annotation
// (a mgmt cluster hosts many HCPs, so ClusterNames alone is not enough). One row per captured
// snapshot event, time-ordered. The cron/paused/phase fields explain whether backups are being
// scheduled at all; isHealthy flags the Enabled phase.
{{if .NoTruncation}}set notruncation;
{{end -}}
kubernetesResourceSnapshots
| where timestamp between ({{.TimestampMin}} .. {{.TimestampMax}})
| where cluster has_any ({{.ClusterNames}})
| where objectKind == "Schedule"
| where namespace == "velero"
| where tostring(object.metadata.annotations["azure.microsoft.com/hcp-cluster-azure-resource-id"]) has '{{.SubResourceGroupId}}'
| extend
    capturedAt = timestamp,
    schedule = name,
    cron = tostring(object.spec.schedule),
    paused = tobool(object.spec.paused),
    resourceID = tostring(object.metadata.annotations["azure.microsoft.com/hcp-cluster-azure-resource-id"]),
    phase = tostring(object.status.phase),
    lastBackup = todatetime(object.status.lastBackup),
    validationErrors = object.status.validationErrors
| extend isHealthy = phase == "Enabled"
| project timestamp, capturedAt, event, cluster, schedule, cron, paused, resourceID, phase, isHealthy, lastBackup, validationErrors
| order by timestamp asc
{{- if gt .Limit 0}}
| limit {{.Limit}}
{{- end}}
