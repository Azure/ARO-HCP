let _startTime = {{.TimestampMin }};
let _endTime = {{.TimestampMax }};
// Discover all cluster IDs over the full range, not each output window.
let _cs_cluster_ids = (
    database('ServiceLogs').table('clustersServiceLogs')
    | where timestamp between ({{.DiscoveryTimestampMin}} .. {{.DiscoveryTimestampMax}})
{{- if .SubscriptionId}}
    | where resource_id startswith '{{.SubResourceGroupId}}/'
{{- else}}
    | where resource_id contains '/resourceGroups/{{.ResourceGroupName}}/'
{{- end}}
    | where isnotempty(cid)
    | distinct cid
);
union
    (
        // Hypershift logs: Hypershift operator reconciliation of HostedCluster and NodePool CRs
        // Includes the CR reconciliation logs
        database('ServiceLogs').table('containerLogs')
        | where timestamp between (_startTime .. _endTime)
        | where namespace_name has "hypershift"
        | extend logStr = tostring(log)
        | where logStr has_any (_cs_cluster_ids)
        | project source = "hypershift", timestamp, container_name, msg = logStr, log
    ),
    (
        // ACM Agent logs: ManifestWork reconciliation on the managed cluster
        // Includes: work agent operations, manifest application, status feedback
        database('ServiceLogs').table('containerLogs')
        | where timestamp between (_startTime .. _endTime)
        | where namespace_name has "open-cluster-management-agent"
        | extend logStr = tostring(log)
        | where logStr has_any (_cs_cluster_ids)
        | project source = "acm-agent", timestamp, container_name, msg = logStr, log
    )
{{if .Summarize -}}
| summarize rows = count(), estimatedBytes = sum(estimate_data_size(*)), firstSeen = min(timestamp), lastSeen = max(timestamp) by source
{{else -}}
| order by timestamp {{.OrderBy}}
{{end -}}
