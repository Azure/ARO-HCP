cluster('{{ .ClusterURI }}').database('{{ .ServiceDatabase }}').table('kubernetesEvents')
| where timestamp between ({{ kqlDatetime .PhaseStartTime }} .. {{ kqlDatetime .PhaseEndTime }})
{{- if .ClusterFilterValues }}
| where cluster in ({{ .ClusterFilterValues }})
{{- end }}
| where eventNamespace in ('{{ .HostedClusterNamespace }}'{{ if .HostedControlPlaneNamespace }}, '{{ .HostedControlPlaneNamespace }}'{{ end }})
| where sourceComponent == 'ignition-server'
| summarize
    firstObserved = min(timestamp),
    lastObserved = max(timestamp),
    observedRecords = count(),
    maxRecordedEventCount = max(tolong(count))
  by cluster, eventNamespace, objectKind, objectName, reason, message
| order by firstObserved asc, cluster asc, eventNamespace asc, objectName asc
