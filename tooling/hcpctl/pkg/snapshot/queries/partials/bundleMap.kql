{{- define "bundleMapCS" -}}
{{ if .ClusterID -}}
let bundleMapCS = cluster('{{ .ClusterURI }}').database('{{ .ServiceDatabase }}').table('clustersServiceLogs')
| where timestamp between ({{ kqlDatetime .FullStartTime }} .. {{ kqlDatetime .FullEndTime }})
{{- if and .ServiceClusterName .ManagementClusterName }}
| where cluster in ('{{ .ServiceClusterName }}', '{{ .ManagementClusterName }}')
{{- end }}
| where cid == '{{ .ClusterID }}'
| where log.msg has 'successfully sent create request of maestro bundle' and log.msg has 'containing resource'
| extend bundleId = extract("bundle id '([^']+)'", 1, tostring(log.msg))
| extend bundleName = extract("maestro bundle name '([^']+)'", 1, tostring(log.msg))
| extend resource = extract("containing resource '([^']+)'", 1, tostring(log.msg))
| extend groupVersion = extract("with GVK '([^,]+),", 1, tostring(log.msg))
| extend resourceKind = extract("Kind=([^']+)", 1, tostring(log.msg))
| where isnotempty(bundleId) and isnotempty(resource)
| extend resourceNamespace = extract("^([^/]+)/", 1, resource)
| extend resourceName = extract("/(.+)$", 1, resource)
| distinct bundleId, bundleName, resource, groupVersion, resourceKind, resourceNamespace, resourceName;
{{ end -}}
{{- end -}}

{{- define "bundleMapBackend" -}}
{{ if and .ClusterResourceID .ServiceProviderResourceType -}}
let bundleMapBackend = cluster('{{ .ClusterURI }}').database('{{ .ServiceDatabase }}').table('cosmosResourceSnapshots')
{{- if .SeedFromIdentity }}
// Identity-seeded (from-cluster): the read-only bundle map lets the maestro/* queries
// correlate in-window logs. cosmosResourceSnapshots is a change feed, so an idle cluster
// whose service-provider snapshot last changed before the window would map to no bundles
// and those logs would be discarded. Scan history up to the window end instead.
| where timestamp <= {{ kqlDatetime .FullEndTime }}
{{- else }}
| where timestamp between ({{ kqlDatetime .FullStartTime }} .. {{ kqlDatetime .FullEndTime }})
{{- end }}
{{- if and .ServiceClusterName .ManagementClusterName }}
| where cluster in ('{{ .ServiceClusterName }}', '{{ .ManagementClusterName }}')
{{- end }}
| where subscriptionID == '{{ .SubscriptionID }}'
| where resourceGroup =~ '{{ .ResourceGroup }}'
| where resourceID =~ '{{ .ClusterResourceID }}' or resourceID startswith '{{ .ClusterResourceID }}/'
| where resourceType =~ '{{ .ServiceProviderResourceType }}'
{{- if .SeedFromIdentity }}
// Collapse each service-provider doc to its latest snapshot and drop soft-deleted ones so
// the map reflects the current bundles, not every historical revision.
| extend deletionTimestamp = tostring(content.deletionTimestamp)
| summarize arg_max(tolong(content._ts), content, deletionTimestamp) by resourceID
| where isempty(deletionTimestamp)
{{- else }}
| summarize content = take_any(content) by etag = tostring(content._etag)
{{- end }}
| mv-expand readOnlyBundle = content.properties.status.maestroReadonlyBundles
| where tostring(readOnlyBundle) != ''
| mv-expand resourceIdentifier = readOnlyBundle.resourceIdentifiers
| distinct
    bundleName = tostring(readOnlyBundle.name),
    maestroBundleName = tostring(readOnlyBundle.maestroAPIMaestroBundleName),
    maestroBundleId = tostring(readOnlyBundle.maestroAPIMaestroBundleID),
    groupVersion = tostring(resourceIdentifier.apiVersion),
    resourceKind = tostring(resourceIdentifier.kind),
    resourceNamespace = tostring(resourceIdentifier.namespace),
    resourceName = tostring(resourceIdentifier.name);
{{ end -}}
{{- end -}}

{{- define "bundleMap" -}}
{{ template "bundleMapCS" . -}}
{{ template "bundleMapBackend" . -}}
let bundleMap = union
{{ if .ClusterID -}}
    (bundleMapCS | project bundleId, groupVersion, resourceKind, resourceNamespace, resourceName, source = 'clustersService', label = strcat(groupVersion, '/', resourceKind, ' ', resource)){{ if and .ClusterResourceID .ServiceProviderResourceType }},{{ end }}
{{ end -}}
{{ if and .ClusterResourceID .ServiceProviderResourceType -}}
    (bundleMapBackend | project bundleId = maestroBundleId, groupVersion, resourceKind, resourceNamespace, resourceName, source = 'backend', label = strcat(groupVersion, '/', resourceKind, ' ', resourceNamespace, '/', resourceName))
{{ end -}}
| summarize groupVersion = take_any(groupVersion), resourceKind = take_any(resourceKind), source = take_any(source), label = take_any(label), resourceNamespace = take_any(resourceNamespace), resourceName = take_any(resourceName) by bundleId;
let bundleIds = bundleMap | project bundleId;
let resourceNameToBundleId = bundleMap
| where isnotempty(resourceName)
| distinct resourceName, bundleId;
{{- end -}}
