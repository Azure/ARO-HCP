cluster('{{ .ClusterURI }}').database('{{ .ServiceDatabase }}').table('kubernetesResourceSnapshots')
| where timestamp between ({{ kqlDatetime .PhaseStartTime }} .. {{ kqlDatetime .PhaseEndTime }})
{{- if and .ServiceClusterName .ManagementClusterNames }}
| where cluster in ('{{ .ServiceClusterName }}'{{ range .ManagementClusterNames }}, '{{ . }}'{{ end }})
{{- end }}
| where objectKind == 'Pod'
| where namespace == strcat('klusterlet-', '{{ .ClusterID }}')
| project
    timestamp,
    pod_name = name,
    event,
    reason = tostring(object.status.reason),
    message = tostring(object.status.message),
    phase = tostring(object.status.phase),
    node = tostring(object.spec.nodeName)
| order by timestamp asc
