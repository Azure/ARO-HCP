cluster('{{ .ClusterURI }}').database('{{ .ServiceDatabase }}').table('cosmosResourceSnapshots')
| where timestamp between ({{ kqlDatetime .FullStartTime }} .. {{ kqlDatetime .FullEndTime }})
{{- if .ManagementClusterPlacementResolved }}
| where cluster in ('{{ .ServiceClusterName }}'{{ range .ManagementClusterNames }}, '{{ . }}'{{ end }})
{{- end }}
| where subscriptionID == '{{ .SubscriptionID }}'
| where resourceGroup =~ '{{ .ResourceGroup }}'
| where resourceID =~ '{{ .ResourceID }}' or resourceID =~ '{{ .ResourceID }}/serviceProviderClusters/default'
| extend internalId=coalesce(tostring(content.properties.clusterServiceID), tostring(content.properties.serviceProviderProperties.clusterServiceID))
| where internalId != ''
| distinct internalId
