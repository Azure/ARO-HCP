{
  "identity": {
    "type": "UserAssigned",
    "userAssignedIdentities": {
      "/subscriptions/sub1/.../mi1": {}
    }
  },
  "location": "eastus",
  "properties": {
    "aadProfile": {
      "enableAzureRBAC": true,
      "managed": true
    },
    "addonProfiles": {
      "azureKeyvaultSecretsProvider": {
        "config": {
          "enableSecretRotation": "true",
          "rotationPollInterval": "1h"
        },
        "enabled": true
      },
      "omsagent": {
        "enabled": false
      }
    },
    "agentPoolProfiles": [
      {
        "availabilityZones": [
          "1",
          "2",
          "3"
        ],
        "enableAutoScaling": true,
        "enableEncryptionAtHost": true,
        "enableFIPS": true,
        "enableNodePublicIP": false,
        "kubeletDiskType": "OS",
        "maxCount": 3,
        "maxPods": 100,
        "minCount": 1,
        "mode": "System",
        "name": "s1abc1234567",
        "nodeLabels": {
          "aro-hcp.azure.com/role": "system"
        },
        "nodeTaints": [
          "CriticalAddonsOnly=true:NoSchedule"
        ],
        "osDiskSizeGB": 32,
        "osDiskType": "Ephemeral",
        "osSKU": "AzureLinux",
        "osType": "Linux",
        "podSubnetID": "/subscriptions/sub1/.../pod-subnet",
        "securityProfile": {
          "enableSecureBoot": false,
          "enableVTPM": false
        },
        "type": "VirtualMachineScaleSets",
        "upgradeSettings": {
          "maxSurge": "10%"
        },
        "vmSize": "Standard_D4ds_v6",
        "vnetSubnetID": "/subscriptions/sub1/.../node-subnet"
      }
    ],
    "autoScalerProfile": {
      "balance-similar-node-groups": "true",
      "daemonset-eviction-for-occupied-nodes": true,
      "max-graceful-termination-sec": "600",
      "max-node-provision-time": "15m",
      "scale-down-delay-after-add": "30m",
      "scale-down-delay-after-delete": "60s",
      "scale-down-delay-after-failure": "3m",
      "scale-down-unneeded-time": "30m",
      "scale-down-unready-time": "20m",
      "scale-down-utilization-threshold": "0.3",
      "scan-interval": "10s",
      "skip-nodes-with-local-storage": "false"
    },
    "autoUpgradeProfile": {
      "nodeOSUpgradeChannel": "NodeImage",
      "upgradeChannel": "patch"
    },
    "azureMonitorProfile": {
      "metrics": {
        "enabled": true,
        "kubeStateMetrics": {
          "metricAnnotationsAllowList": "",
          "metricLabelsAllowlist": ""
        }
      }
    },
    "disableLocalAccounts": true,
    "dnsPrefix": "cluster1",
    "enableRBAC": true,
    "kubernetesVersion": "1.31.1",
    "metricsProfile": {
      "costAnalysis": {
        "enabled": false
      }
    },
    "networkProfile": {
      "advancedNetworking": {
        "enabled": true,
        "observability": {
          "enabled": true
        }
      },
      "dnsServiceIP": "10.130.0.10",
      "ipFamilies": [
        "IPv4"
      ],
      "loadBalancerProfile": {
        "outboundIPs": {
          "publicIPs": [
            {
              "id": "/subscriptions/sub1/.../outbound-ip"
            }
          ]
        }
      },
      "loadBalancerSku": "standard",
      "networkDataplane": "cilium",
      "networkPlugin": "azure",
      "networkPolicy": "cilium",
      "serviceCidr": "10.130.0.0/16",
      "serviceCidrs": [
        "10.130.0.0/16"
      ]
    },
    "nodeResourceGroup": "rg1-aks1",
    "oidcIssuerProfile": {
      "enabled": true
    },
    "securityProfile": {
      "azureKeyVaultKms": {
        "enabled": true,
        "keyId": "https://kv1.vault.azure.net/keys/aks-etcd-encryption/abc123",
        "keyVaultNetworkAccess": "Public"
      },
      "imageCleaner": {
        "enabled": true,
        "intervalHours": 24
      },
      "workloadIdentity": {
        "enabled": true
      }
    },
    "servicePrincipalProfile": {
      "clientId": "msi"
    },
    "storageProfile": {
      "diskCSIDriver": {
        "enabled": true
      },
      "fileCSIDriver": {
        "enabled": true
      },
      "snapshotController": {
        "enabled": true
      }
    },
    "supportPlan": "KubernetesOfficial"
  },
  "sku": {
    "name": "Base",
    "tier": "Standard"
  },
  "tags": {
    "aro-hcp-provisioning": "true",
    "clusterType": "mgmt",
    "persist": "true"
  }
}
