// @owner: sre-team
// @domain: Triage/Resolvers
// @depends: cosmosResourceSnapshots
// @params: p_ResourceId=ARM resource ID (case-insensitive), p_StartTime=window start, p_EndTime=window end
// @returns: single row with cluster_id string column
.create-or-alter function
with (
  docstring = 'Resolves an ARM resource ID to an internal Clusters Service cluster_id. | Returns: single row with cluster_id (internal format) | Example: let cid = toscalar(ResolveClusterId("/subscriptions/.../hcpOpenShiftClusters/foo", ago(7d), now()))',
  folder = 'Triage\\Resolvers'
)
ResolveClusterId(p_ResourceId: string, p_StartTime: datetime, p_EndTime: datetime)
{
    cosmosResourceSnapshots
    | where timestamp between (p_StartTime .. p_EndTime)
    | where resourceType =~ "Microsoft.RedHatOpenShift/hcpOpenShiftClusters"
    | where cosmosContainer == "resources"
    | where resourceID =~ p_ResourceId
    | extend csid = tostring(content.properties.serviceProviderProperties.clusterServiceID)
    | where isnotempty(csid)
    | summarize arg_max(timestamp, csid)
    | extend cluster_id = extract(@"clusters/([^/]+)$", 1, csid)
    | where isnotempty(cluster_id)
    | project cluster_id
    | take 1
}
