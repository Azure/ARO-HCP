// @owner: sre-team
// @domain: Triage/Resolvers
// @depends: cosmosResourceSnapshots
// @params: p_ClusterId=internal Clusters Service cluster_id, p_StartTime=window start, p_EndTime=window end
// @returns: single row with resource_id string column (ARM resource ID)
.create-or-alter function
with (
  docstring = 'Resolves an internal Clusters Service cluster_id back to its ARM resource ID. | Returns: single row with resource_id (ARM format) | Example: let rid = toscalar(ResolveResourceId("abc123", ago(7d), now()))',
  folder = 'Triage\\Resolvers'
)
ResolveResourceId(p_ClusterId: string, p_StartTime: datetime, p_EndTime: datetime)
{
    cosmosResourceSnapshots
    | where timestamp between (p_StartTime .. p_EndTime)
    | where resourceType =~ "Microsoft.RedHatOpenShift/hcpOpenShiftClusters"
    | where cosmosContainer == "resources"
    | extend csid = tostring(content.properties.serviceProviderProperties.clusterServiceID)
    | where csid endswith strcat("clusters/", p_ClusterId)
    | summarize arg_max(timestamp, resourceID) by csid
    | project resource_id = resourceID
    | take 1
}
