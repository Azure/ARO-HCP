.create-merge table kubernetesResourceInventorySnapshots (
  timestamp: datetime,
  environment: string,
  region: string,
  cluster: string,
  snapshotId: string,
  snapshotTime: datetime,
  apiGroup: string,
  apiVersion: string,
  resource: string,
  objectKind: string,
  scope: string,
  status: string,
  expectedItemCount: long,
  listResourceVersion: string,
  listStartedAt: datetime,
  listCompletedAt: datetime,
  listDurationMs: long,
  emitStartedAt: datetime,
  emitCompletedAt: datetime,
  emitDurationMs: long,
  scheduledAt: datetime,
  scheduleDelayMs: long,
  nextCheckpointAt: datetime,
  pageCount: long,
  uncompressedResponseBytes: long,
  errorMessage: string,
  printerColumns: dynamic
)

.create-or-alter table kubernetesResourceInventorySnapshots ingestion json mapping 'ingestionMapping'
```
