// Complete per-computation envelopes, not an observation census. Retry copies
// are allowed; readers validate and collapse them before joining retained raw
// inputs. Multiplicity and enrichment status belong to current raw inputs.
// Retention inherits the ServiceLogs database policy (90 days).
.create-merge table ciFailurePatterns (
    resultKey: string,
    rawFingerprint: string,
    extractorVersion: string,
    resultSchemaVersion: long,
    origin: string,
    buildId: string,
    source: string,
    testId: string,
    startedAt: datetime,
    finishedAt: datetime,
    setupFinishTime: datetime,
    testStartTime: datetime,
    cleanupStartTime: datetime,
    message: string,
    testName: string,
    findings: dynamic,
    computedAt: datetime,
    producerCommit: string
)
with (
    docstring = "Complete version-qualified CI failure findings; current raw inputs determine population and multiplicity",
    folder = "CI"
)

.create-or-alter table ciFailurePatterns ingestion json mapping "ciFailurePatternsMapping"
```
[
  {"column":"resultKey","path":"$['resultKey']","datatype":"string"},
  {"column":"rawFingerprint","path":"$['rawFingerprint']","datatype":"string"},
  {"column":"extractorVersion","path":"$['extractorVersion']","datatype":"string"},
  {"column":"resultSchemaVersion","path":"$['resultSchemaVersion']","datatype":"long"},
  {"column":"origin","path":"$['origin']","datatype":"string"},
  {"column":"buildId","path":"$['buildId']","datatype":"string"},
  {"column":"source","path":"$['source']","datatype":"string"},
  {"column":"testId","path":"$['testId']","datatype":"string"},
  {"column":"startedAt","path":"$['startedAt']","datatype":"datetime"},
  {"column":"finishedAt","path":"$['finishedAt']","datatype":"datetime"},
  {"column":"setupFinishTime","path":"$['setupFinishTime']","datatype":"datetime"},
  {"column":"testStartTime","path":"$['testStartTime']","datatype":"datetime"},
  {"column":"cleanupStartTime","path":"$['cleanupStartTime']","datatype":"datetime"},
  {"column":"message","path":"$['message']","datatype":"string"},
  {"column":"testName","path":"$['testName']","datatype":"string"},
  {"column":"findings","path":"$['findings']","datatype":"dynamic"},
  {"column":"computedAt","path":"$['computedAt']","datatype":"datetime"},
  {"column":"producerCommit","path":"$['producerCommit']","datatype":"string"}
]
```

// Do not silently apply ADX's default 1 MiB value limit to complete evidence
// or findings. The writer separately bounds whole rows and submission batches.
.alter column ciFailurePatterns.message policy encoding type='BigObject32'
.alter column ciFailurePatterns.testName policy encoding type='BigObject32'
.alter column ciFailurePatterns.findings policy encoding type='BigObject32'
