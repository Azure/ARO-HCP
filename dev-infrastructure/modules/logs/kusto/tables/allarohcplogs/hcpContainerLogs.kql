// HCP (Hosted Control Plane) container logs: everything from an ocm-* namespace.
//
// This replaces the old HostedControlPlaneLogs.containerLogs table (same schema).
// Isolation and the shorter 14-day retention that used to be a property of the
// separate HostedControlPlaneLogs database are preserved here as a table-level
// retention policy inside AllAroHcpLogs (spec R5, D3).
.create-merge table hcpContainerLogs (
  timestamp: datetime,
  log: dynamic,
  environment: string,
  cluster: string,
  namespace_name: string,
  container_name: string,
  container_image: string,           // fluentbit: kubernetes.container_image
  host: string,
  labels: string,
  pod_name: string,
  region: string,
  tag: string,                       // fluentbit: tag routing identifier
  container_status_image_id: string, // fluentbit: kubernetes.container_hash (k8s status.containerStatuses.imageID)
  cluster_id: string,                // fluentbit: cluster_id (Azure ARM resource ID; uppercased by the arobit forwarder)
  resource_group: string             // fluentbit: resource_group (RG segment of the ARM resource ID; uppercased by the arobit forwarder)
)

.alter-merge table hcpContainerLogs policy retention softdelete = 14d

.create-or-alter function with (skipvalidation = "true", docstring = "Route ocm-* namespace container logs to hcpContainerLogs")
rawToHcpContainerLogs() {
    rawLogs
    | where isempty(tostring(log.snapshotType))
    | where tostring(log.kubernetes.namespace_name) startswith "ocm-"
    | project
        timestamp,
        log = log.log,
        environment = tostring(log.environment),
        cluster = tostring(log.cluster),
        namespace_name = tostring(log.kubernetes.namespace_name),
        container_name = tostring(log.kubernetes.container_name),
        container_image = tostring(log.kubernetes.container_image),
        host = tostring(log.kubernetes.host),
        labels = tostring(log.kubernetes.labels),
        pod_name = tostring(log.kubernetes.pod_name),
        region = tostring(log.region),
        tag,
        container_status_image_id = tostring(log.kubernetes.container_hash),
        cluster_id = tostring(log.cluster_id),
        resource_group = tostring(log.resource_group)
}

.alter table hcpContainerLogs policy update @'[{"IsEnabled": true, "Source": "rawLogs", "Query": "rawToHcpContainerLogs()", "IsTransactional": true, "PropagateIngestionProperties": false}]'
