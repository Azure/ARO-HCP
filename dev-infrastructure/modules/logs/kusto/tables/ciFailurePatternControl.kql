// One row per coverage check the ci-failure-patterns controller chose to record.
// The row with the greatest coverageCheckedAt names the active
// (extractorVersion, resultSchemaVersion) pair; consumers read it through
// ciFailurePatternActive. Heartbeat rows keep that record alive. Retention
// inherits the ServiceLogs database policy (90 days).
.create-merge table ciFailurePatternControl (
    extractorVersion: string,
    resultSchemaVersion: long,
    coverageCheckedAt: datetime,
    rawFailedInputsConsidered: long,
    rawFailedInputsWithoutResult: long
)
with (
    docstring = "Coverage checks of ciFailurePatterns against raw failed inputs; the newest row names the active extractor version",
    folder = "CI"
)

.create-or-alter table ciFailurePatternControl ingestion json mapping "ciFailurePatternControlMapping"
```
[
  {"column":"extractorVersion","path":"$['extractorVersion']","datatype":"string"},
  {"column":"resultSchemaVersion","path":"$['resultSchemaVersion']","datatype":"long"},
  {"column":"coverageCheckedAt","path":"$['coverageCheckedAt']","datatype":"datetime"},
  {"column":"rawFailedInputsConsidered","path":"$['rawFailedInputsConsidered']","datatype":"long"},
  {"column":"rawFailedInputsWithoutResult","path":"$['rawFailedInputsWithoutResult']","datatype":"long"}
]
```

// Consumer entry point: the ciFailurePatterns rows of the (extractorVersion,
// resultSchemaVersion) pair named by the control row with the greatest
// coverageCheckedAt, collapsed to one row per resultKey (retry copies differ only
// in computedAt). Returns no rows while no control row exists. skipvalidation is
// required because table scripts are deployed independently and ciFailurePatterns
// may not exist yet.
.create-or-alter function
with (docstring = 'Failure pattern results of the active extractor version, one row per resultKey', folder = 'CI', skipvalidation = "true")
ciFailurePatternActive() {
    let active = ciFailurePatternControl
        | top 1 by coverageCheckedAt desc
        | project extractorVersion, resultSchemaVersion;
    ciFailurePatterns
    | join kind=inner active on extractorVersion, resultSchemaVersion
    | summarize arg_max(computedAt, *) by resultKey
}
