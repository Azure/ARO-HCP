ARG NESTED_PODMAN_IMAGE=quay-proxy.ci.openshift.org/ci/nested-podman:latest
FROM ${NESTED_PODMAN_IMAGE}

ARG GOTESTSUM_VERSION=1.13.0
ARG ENVTEST_VERSION=v0.0.0-20260125163108-a19ec76a3c5d
ARG ENVTEST_K8S_VERSION=1.34.1

USER root

RUN printf '%s\n' \
        '[epel]' \
        'name=Extra Packages for Enterprise Linux 9 - $basearch' \
        'metalink=https://mirrors.fedoraproject.org/metalink?repo=epel-9&arch=$basearch' \
        'enabled=1' \
        'gpgcheck=1' \
        'gpgkey=https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-9' \
        > /etc/yum.repos.d/epel.repo

# pass requires tree, which is not available in the UBI repositories.
RUN printf '%s\n' \
        '[centos-stream-tree]' \
        'name=CentOS Stream 9 - tree' \
        'baseurl=https://mirror.stream.centos.org/9-stream/BaseOS/$basearch/os/' \
        'enabled=1' \
        'includepkgs=tree' \
        'gpgcheck=1' \
        'gpgkey=https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official-SHA256' \
        > /etc/yum.repos.d/centos-stream-tree.repo

RUN dnf install -y git go make pass qrencode net-tools tree && dnf clean all

# Build pinned helpers for the image's native architecture without source context
# or retained module/build caches. Keep GOPATH writable for non-root CI jobs.
# Isolate HOME too: Go telemetry must not create root-owned runtime config.
RUN mkdir -p /opt/app-root/bin && chmod 777 /opt/app-root && \
    export HOME=/tmp/ci-helper-home GOBIN=/opt/app-root/bin GOPATH=/tmp/ci-helper-build GOCACHE=/tmp/ci-helper-cache && \
    go install gotest.tools/gotestsum@v${GOTESTSUM_VERSION} && \
    go install sigs.k8s.io/controller-runtime/tools/setup-envtest@${ENVTEST_VERSION} && \
    rm -rf /tmp/ci-helper-build /tmp/ci-helper-cache "${HOME}" && \
    chown 1000:0 /opt/app-root/bin && chmod 0775 /opt/app-root/bin

# setup-envtest selects the native Linux architecture. Its versioned store stays
# root-owned; the stable symlink and identity file are the runner's asset contract.
RUN export HOME=/tmp/ci-helper-home && \
    assets=$(/opt/app-root/bin/setup-envtest --bin-dir=/opt/envtest use "${ENVTEST_K8S_VERSION}" -p path) && \
    ln -s "${assets}" /opt/envtest/assets && \
    printf '%s\n' "${ENVTEST_K8S_VERSION}" > /opt/envtest/version && \
    chmod -R a+rX,go-w /opt/envtest && \
    rm -rf "${HOME}"

ENV PATH="${PATH}:/opt/app-root/bin" \
    ENVTEST_ASSETS_VERSION="${ENVTEST_K8S_VERSION}" \
    ENVTEST_PREBUILT_BIN_DIR=/opt/envtest \
    ENVTEST_PREBUILT_ASSETS=/opt/envtest/assets

# ci-operator clones source into /go before the test commands set GOPATH.
RUN mkdir -p /go && chown 1000:0 /go && chmod 0775 /go

USER 1000

# Fail the image build if the default user cannot prepare a checkout or runtime config.
RUN clone_root=$(mktemp -d /go/source-clone.XXXXXX) && \
    git init --quiet "${clone_root}/src/github.com/Azure/ARO-HCP" && \
    rm -rf "${clone_root}" && \
    mkdir -p "${HOME}/.config/containers" && \
    config_probe=$(mktemp "${HOME}/.config/containers/.ci-permissions.XXXXXX") && \
    rm -f "${config_probe}"
