<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cluster utilization</title>
  <style>
    :root { color-scheme: dark; }
    * { box-sizing: border-box; }
    body { margin: 0; background: #0d1117; color: #e6edf3; font: 14px/1.5 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
    main { max-width: 1600px; margin: auto; padding: 24px; }
    h1 { margin: 0; font-size: 26px; } h2 { font-size: 19px; margin: 0 0 8px; } h3 { margin: 0 0 8px; font-size: 16px; overflow-wrap: anywhere; }
    p { margin: 8px 0; } .muted, small { color: #9da7b3; } .eyebrow { color: #58a6ff; text-transform: uppercase; font-size: 11px; letter-spacing: .12em; }
    section { margin-top: 24px; } .panel, .card { background: #161b22; border: 1px solid #30363d; border-radius: 6px; padding: 16px; }
    .controls { display: flex; gap: 12px; flex-wrap: wrap; align-items: end; margin: 20px 0; }
    label { display: flex; flex-direction: column; gap: 5px; color: #9da7b3; }
    select, input, button { font: inherit; color: #e6edf3; background: #21262d; border: 1px solid #484f58; border-radius: 4px; padding: 7px 10px; max-width: 100%; }
    select { min-width: 130px; } button, summary { cursor: pointer; } button:hover { border-color: #58a6ff; } :focus-visible { outline: 2px solid #58a6ff; outline-offset: 2px; }
    #snapshot { max-width: 650px; } #cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
    dl { margin: 0; } .metric { display: flex; justify-content: space-between; gap: 12px; padding: 5px 0; border-bottom: 1px solid #30363d; } dt { color: #9da7b3; } dd { margin: 0; text-align: right; font-variant-numeric: tabular-nums; }
    .resource-section { margin: 14px 0; border-top: 2px solid var(--resource-accent); } .resource-section.cpu { --resource-accent: #79b8ff; --resource-tint: #1b2b40; } .resource-section.memory { --resource-accent: #c4a4ef; --resource-tint: #2b2338; }
    .resource-heading { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 8px; background: var(--resource-tint); color: var(--resource-accent); } .resource-heading h4 { margin: 0; font-size: 14px; } .peak-badge { border: 1px solid var(--resource-accent); border-radius: 3px; padding: 1px 6px; font-size: 11px; font-weight: 600; }
    .warning { border-left: 4px solid #d29922; background: #292315; padding: 12px 16px; margin: 12px 0; overflow-wrap: anywhere; } .warning h2 { color: #e3b341; } .warning ul { margin: 0; padding-left: 20px; }
    .coverage-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; } .coverage-grid p { margin-bottom: 0; } .diagnostics { width: 100%; height: 260px; background: #161b22; color: #e6edf3; border: 1px solid #484f58; padding: 8px; font: 12px/1.5 monospace; }
    .timeline { height: 18px; width: 100%; border: 1px solid #9da7b3; border-radius: 3px; position: relative; } .timeline-peak { position: absolute; top: -4px; bottom: -4px; border-left: 2px solid #fff; } .coverage-resource { margin: 16px 0; } .coverage-resource textarea { height: 150px; }
    .chart-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } .chart-pair > div { min-width: 0; } .chart { width: 100%; height: 360px; } .legend { display: flex; flex-wrap: wrap; gap: 18px; margin: 10px 0; } .swatch { display: inline-block; width: 12px; height: 12px; margin-right: 5px; } .used { background: #316dca; } .unused { background: #303944; } .unknown { background: #99752d; }
    .breadcrumbs { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0; align-items: center; } .breadcrumbs button { overflow-wrap: anywhere; text-align: left; } .scope { font-variant-numeric: tabular-nums; } .metric dd { min-width: 0; } .metric dd span { display: block; }
    .table-scroll { width: 100%; overflow-x: auto; } table { border-collapse: collapse; width: 100%; font-size: 13px; } th, td { text-align: left; padding: 9px 10px; border-bottom: 1px solid #30363d; vertical-align: top; } th { color: #9da7b3; white-space: nowrap; } td { overflow-wrap: anywhere; } td.numeric { white-space: nowrap; font-variant-numeric: tabular-nums; } th button { border: 0; background: none; padding: 0; color: inherit; }
    details { margin: 8px 0; } summary { color: #79c0ff; } .detail { padding: 8px; border-left: 2px solid #30363d; min-width: 620px; } .selected { background: #1b304a; } #selection { color: #79c0ff; } .empty { padding: 20px; color: #9da7b3; }
    @media (max-width: 800px) { .chart-pair { grid-template-columns: 1fr; } }
    @media (max-width: 650px) { main { padding: 12px; } .panel { padding: 12px; } .controls > label { width: 100%; } select, input { width: 100%; } #cards { grid-template-columns: 1fr; } .chart { height: 320px; } h1 { font-size: 23px; } }
  </style>
</head>
<body>
<main>
  <header><div class="eyebrow">Observability / Resource utilization</div><h1>Cluster utilization</h1><p id="window" class="muted"></p></header>
  <noscript><p class="warning">JavaScript is required to explore this embedded report. No Azure credentials are needed.</p></noscript>
  <div class="controls">
    <label>Snapshot and selection reason<select id="snapshot"></select></label>
  </div>
  <div id="warnings" class="warning" role="status"></div>
  <section aria-labelledby="totals-title"><h2 id="totals-title">Cluster totals</h2><p class="muted">Whole-cluster totals at the selected snapshot, independent of workload filters. Unknown measurements are never zero; partial sums show measured coverage.</p><div id="cards"></div></section>
  <section class="panel" aria-labelledby="capacity-title">
    <div class="eyebrow">01 / Physical footprint</div><h2 id="capacity-title">Capacity by cluster, pool and node</h2>
    <p>Explore fleet clusters, then node pools, then nodes. Both charts share one path. Area is physical capacity, not allocatable or requests. Select a node to scope workload detail below. Workload search and area basis never change capacity.</p>
    <nav id="capacity-path" class="breadcrumbs" aria-label="Capacity path"></nav>
    <div class="legend"><span><i class="swatch used"></i>Known node usage</span><span><i class="swatch unused"></i>Known unused CPU / available memory</span><span><i class="swatch unknown"></i>Unknown usage, not free</span></div>
    <p id="chart-status" class="muted" role="status">Charts are loading. All totals and tables work without the chart CDN.</p>
    <div class="chart-pair">
      <div><h3>CPU capacity</h3><p id="capacity-total-cpu" class="scope"></p><div id="capacity-chart-cpu" class="chart" hidden role="img" aria-label="CPU capacity. Navigate using the equivalent table below."></div><p id="coverage-cpu" class="muted"></p></div>
      <div><h3>Memory capacity</h3><p id="capacity-total-memory" class="scope"></p><div id="capacity-chart-memory" class="chart" hidden role="img" aria-label="Memory capacity. Navigate using the equivalent table below."></div><p id="coverage-memory" class="muted"></p></div>
    </div>
    <div id="capacity-pages" class="controls"></div><div class="table-scroll"><table><thead><tr><th>Drill into scope</th><th>CPU capacity / known used / known unused / unknown</th><th>Memory capacity / known used / known available / unknown</th></tr></thead><tbody id="capacity-rows"></tbody></table></div>
    <details id="node-details"><summary>Node measurements in this capacity scope</summary><div id="node-pages" class="controls"></div><div class="table-scroll"><table><thead><tr><th>Cluster / pool / SKU</th><th>Node</th><th>CPU capacity</th><th>CPU allocatable</th><th>CPU usage</th><th>Unused CPU</th><th>Memory capacity</th><th>Memory allocatable</th><th>Memory usage</th><th>Available memory</th></tr></thead><tbody id="nodes"></tbody></table></div></details>
  </section>
  <section class="panel" aria-labelledby="workloads-title">
    <div class="eyebrow">02 / Workload composition</div><h2 id="workloads-title">HCP components and exact owners</h2>
    <p>Explore svc and mgmt roles, then workloads aggregated across clusters, then each cluster's workload and its exact namespace, owner, placement and container records. HCP components use the collector's attribution across namespaces; platform workloads retain exact namespace / kind / name. Unrecognized cluster roles appear as Other. ReplicaSet names are never guessed into Deployment names.</p>
    <p class="muted">Finite limits sum only configured limits. Confirmed unlimited instances contribute zero to that sum and are counted separately. Unknown limit-query coverage is shown as Unknown, never as zero unlimited instances.</p>
    <div class="controls"><label>Workload search<input id="search" type="search" placeholder="Component, namespace, owner or node"></label><label>Composition area<select id="basis"><option value="usage">Container usage</option><option value="requests">Container requests</option></select></label><button id="clear-node" type="button">Clear node selection</button><span id="selection" role="status"></span></div>
    <nav id="workload-path" class="breadcrumbs" aria-label="Workload path"></nav>
    <p id="composition-note" class="muted"></p>
    <div class="chart-pair">
      <div><h3>CPU workloads</h3><p id="workload-total-cpu" class="scope"></p><div id="composition-chart-cpu" class="chart" hidden role="img" aria-label="CPU workloads. Navigate using the equivalent table below."></div></div>
      <div><h3>Memory workloads</h3><p id="workload-total-memory" class="scope"></p><div id="composition-chart-memory" class="chart" hidden role="img" aria-label="Memory workloads. Navigate using the equivalent table below."></div></div>
    </div>
    <div id="workload-pages" class="controls"></div>
    <div class="table-scroll"><table id="workloads"><thead><tr><th aria-sort="ascending"><button data-sort="name">Role / workload / cluster</button></th><th><button data-sort="pods">Pods</button></th><th><button data-sort="pending">Pending</button></th><th><button data-sort="cpu.usage">CPU usage</button></th><th><button data-sort="cpu.requests">CPU requests</button></th><th><button data-sort="cpu.limits">CPU finite limits</button></th><th>CPU unlimited</th><th><button data-sort="memory.usage">Memory usage</button></th><th><button data-sort="memory.requests">Memory requests</button></th><th><button data-sort="memory.limits">Memory finite limits</button></th><th>Memory unlimited</th></tr></thead><tbody id="workload-rows"></tbody></table></div>
  </section>
  <section class="panel"><h2>How to read this report</h2><p id="measurement-windows"></p><p>CPU is measured in cores; memory is displayed in GiB (1 GiB = 1,073,741,824 bytes). Node CPU usage includes host activity; node memory usage is node-exporter total minus available memory. Memory capacity uses the smoothed node-exporter total, so the available-memory tile equals that total minus node usage. Available memory is not safely removable capacity. Whole-node utilization percentages use physical capacity, not allocatable, and require complete usage and positive capacity for all observed nodes. Container CPU and memory working-set metrics have different accounting and coverage, so their sums need not equal node usage. They are not subtracted from node capacity in the main treemap.</p><p>Requests are sums of observed container requests, not scheduler-effective pod reservations: init containers, pod overhead and scheduling constraints can differ. Pending / unscheduled demand is listed separately, never assigned to a fictional pool. Finite limits exclude unlimited instances; a missing limit is not a zero limit. Unlimited counts come from observed container instances; missing container detail means unknown coverage.</p><p class="muted">These are observational snapshots, not a scheduling simulation or a recommendation about safe capacity. Missing capacity, unknown usage, stale samples and incomplete collection can prevent a complete comparison.</p></section>
</main>
<script id="utilization-data" type="application/json">{{.}}</script>
<script>
'use strict';
const report = JSON.parse(document.getElementById('utilization-data').textContent);
const $ = id => document.getElementById(id);
const list = value => value || [];
const known = value => typeof value === 'number' && Number.isFinite(value);
const nodeKey = (cluster, node) => JSON.stringify([cluster, node]);
const resources = ['cpu', 'memory'], capacityCharts = {}, compositionCharts = {};
let selectedNode = '', sortKey = 'name', sortDirection = 1, capacityPath = [], workloadPath = [];
let currentNodes = [], capacityGroups = [], currentGroups = [], currentWorkloads = [];
const groupPageSize = 25, detailPageSize = 20, nodePageSize = 25;
let capacityPage = 0, workloadPage = 0, nodePage = 0, activeDetails, searchTimer;
const quantityFormat = new Intl.NumberFormat('en-US', {maximumFractionDigits: 2});
const percentFormat = new Intl.NumberFormat('en-US', {maximumFractionDigits: 1});
function el(tag, text, className) {
  const element = document.createElement(tag);
  if (text !== undefined) element.textContent = text;
  if (className) element.className = className;
  return element;
}
function metric(row, field, resource) { return row[field]?.[resource]; }
function quantity(value, resource) {
  if (!known(value)) return 'Unknown';
  return quantityFormat.format(value / (resource === 'memory' ? 1073741824 : 1)) + (resource === 'memory' ? ' GiB' : ' cores');
}
function sum(rows, field, resource) {
  const values = rows.map(row => metric(row, field, resource)).filter(known);
  return {value: values.length ? values.reduce((a, b) => a + b, 0) : null, count: values.length, total: rows.length};
}
function totalText(total, resource) {
  return quantity(total.value, resource) + (total.count < total.total ? ' (partial: ' + total.count + '/' + total.total + ')' : '');
}
function nodeUtilization(nodes, resource) {
  if (!nodes.length) return 'Unknown';
  if (nodes.some(node => !known(metric(node, 'capacity', resource)) || metric(node, 'capacity', resource) <= 0 || !known(metric(node, 'usage', resource)))) return 'Unknown (incomplete coverage or capacity)';
  return percentFormat.format(100 * sum(nodes, 'usage', resource).value / sum(nodes, 'capacity', resource).value) + '%';
}
function snapshot() { return list(report.snapshots)[Number($('snapshot').value)] || {nodes: [], workloads: []}; }
function unlimited(rows, resource) {
  const containers = rows.flatMap(row => list(row.containers));
  const key = resource === 'cpu' ? 'unlimitedCPU' : 'unlimitedMemory';
  const counts = containers.map(container => container[key]).filter(known);
  if (!counts.length) return 'Unknown';
  const count = counts.reduce((total, value) => total + value, 0);
  return count + (counts.length < containers.length || rows.some(row => !list(row.containers).length) ? ' (partial; remainder Unknown)' : '');
}
function addMetric(parent, title, text) {
  const line = el('div', undefined, 'metric'); line.append(el('dt', title), el('dd', text)); parent.append(line);
}
function chooseNode(key) {
  const node = list(snapshot().nodes).find(n => nodeKey(n.cluster, n.name) === key);
  navigateCapacity(node ? [node.cluster, node.pool || '', node.name] : capacityPath.slice(0, 2));
}
function coverageStats(coverage) {
  const intervals = coverage.intervals, first = intervals.findIndex(i => i.eligible), last = intervals.findLastIndex(i => i.eligible);
  const counts = {eligible: 0, leading: 0, trailing: 0, interior: 0, allmissing: 0};
  const gaps = [];
  intervals.forEach((interval, index) => {
    const kind = interval.eligible ? 'eligible' : first < 0 ? 'allmissing' : index < first ? 'leading' : index > last ? 'trailing' : 'interior';
    const minutes = (Date.parse(interval.end) - Date.parse(interval.start)) / 60000 + 1;
    counts[kind] += minutes;
    if (!interval.eligible) gaps.push({...interval, kind, minutes});
  });
  return {...counts, gaps, total: Object.values(counts).reduce((a, b) => a + b, 0)};
}
function coveragePeak(coverage) {
  const reason = coverage.scope + ' ' + (coverage.resource === 'cpu' ? 'CPU' : 'memory') + ' peak';
  return list(report.snapshots).find(s => list(s.reasons).includes(reason))?.time;
}
function adjacentGap(stats, peak) {
  const time = Date.parse(peak);
  return stats.gaps.some(i => Math.min(Math.abs(time - Date.parse(i.start)), Math.abs(time - Date.parse(i.end))) <= 120000);
}
function renderCoverageTimeline(host) {
  const coverage = list(report.coverage);
  const summary = el('p'); summary.id = 'timeline-summary'; host.append(summary);
  if (!coverage.length) {
    summary.textContent = 'Missing timestamps were not saved in this artifact. Cannot distinguish startup/teardown gaps from intermittent loss.';
    return;
  }
  const stats = coverage.map(coverageStats), interior = stats.filter(s => s.interior).length, edges = stats.filter(s => !s.interior && (s.leading || s.trailing)).length, missing = stats.filter(s => s.allmissing).length;
  summary.textContent = 'Recorded peak-search coverage: ' + coverage.length + ' scope/resource timelines; ' + stats.filter(s => s.eligible === s.total).length + ' complete, ' + edges + ' edge-only gaps, ' + interior + ' with interior gaps, ' + missing + ' all missing. ' +
    (edges ? 'Edge-only gaps are compatible with startup/teardown, not proof of either. ' : '') +
    (interior ? 'Interior gaps indicate spotty coverage; the run peak is uncertain. ' : '') +
    (missing ? 'All-missing timelines have no eligible sample; no peak or startup/teardown explanation can be established. ' : '') +
    'Counts refer to overlapping scopes and resources, not independent time windows. Unrecorded scopes are unknown.';
  const details = el('details'), title = el('summary', 'Coverage timeline by scope: CPU and memory'); details.id = 'coverage-timelines'; details.append(title); host.append(details);
  details.ontoggle = () => {
    details.replaceChildren(title);
    if (!details.open) return;
    const scopes = [...new Set(coverage.map(c => c.scope))], content = el('div'); details.append(content);
    const page = index => {
      content.replaceChildren(); const controls = el('div', undefined, 'controls'); content.append(controls);
      pageControls(controls, index, 25, scopes.length, page, 'coverage scopes');
      for (const scope of scopes.slice(index * 25, (index + 1) * 25)) {
        const group = el('details'), heading = el('summary', scope); group.append(heading); content.append(group);
        group.ontoggle = () => {
          group.replaceChildren(heading);
          if (!group.open) return;
          for (const resource of resources) {
            const row = coverage.find(c => c.scope === scope && c.resource === resource), box = el('div', undefined, 'coverage-resource'); group.append(box);
            box.append(el('strong', resource === 'cpu' ? 'CPU' : 'Memory'));
            if (!row) { box.append(el('p', 'Coverage timeline not saved for this resource.')); continue; }
            const s = coverageStats(row), peak = coveragePeak(row), start = Date.parse(row.intervals[0].start);
            box.append(el('p', s.eligible + '/' + s.total + ' eligible minute samples; ' + (s.total - s.eligible) + ' excluded. Leading: ' + s.leading + '; trailing: ' + s.trailing + '; interior: ' + s.interior + '; all missing: ' + s.allmissing + '.'));
            const bar = el('div', undefined, 'timeline'); bar.setAttribute('role', 'img'); bar.setAttribute('aria-label', resource + ' coverage: blue eligible, amber incomplete; exact inclusive UTC intervals below');
            bar.style.background = 'linear-gradient(to right, ' + row.intervals.map(i => {
              const color = i.eligible ? '#316dca' : '#99752d';
              return color + ' ' + ((Date.parse(i.start) - start) / 60000 / s.total * 100) + '% ' + (((Date.parse(i.end) - start) / 60000 + 1) / s.total * 100) + '%';
            }).join(', ') + ')'; box.append(bar);
            box.append(el('p', row.intervals[0].start + ' to ' + row.intervals[row.intervals.length - 1].end + ' (inclusive UTC minute samples). Blue: eligible; amber: incomplete.'));
            if (peak) {
              const marker = el('span', undefined, 'timeline-peak'); marker.style.left = ((Date.parse(peak) - start) / 60000 + 0.5) / s.total * 100 + '%'; bar.append(marker);
              box.append(el('p', 'White marker: selected peak ' + peak + '. ' + (adjacentGap(s, peak) ? 'Adjacent incomplete sample within 2 minutes of this peak. ' : '') + (s.gaps.length ? 'Highest eligible sample, not a proven run maximum.' : 'Shorter bursts can fall between samples.')));
            }
            if (!s.gaps.length) { box.append(el('p', 'No excluded minute samples.')); continue; }
            box.append(el('p', 'Gap intervals below are inclusive. Reason counts are nodes affected at EACH minute, not totals across time; reasons may overlap. Missing clusters are counted separately. Node counts describe observed nodes, not a known fleet size.'));
            const raw = el('textarea', undefined, 'diagnostics'); raw.readOnly = true; raw.setAttribute('aria-label', scope + ' ' + resource + ' gap intervals');
            raw.value = s.gaps.map(i => i.start + ' to ' + i.end + ' | ' + i.minutes + ' minute samples | ' + i.kind + ' | nodes=' + i.nodes + ' | missing inventory=' + (i.missingInventory || 0) + ' | missing usage=' + (i.missingUsage || 0) + ' | missing capacity=' + (i.missingCapacity || 0) + ' | missing clusters=' + (i.missingClusters || 0)).join('\n'); box.append(raw);
          }
        };
      }
    };
    page(0);
  };
}
function renderCoverage(nodes, workloads, warnings) {
  const host = $('warnings'); host.replaceChildren(el('h2', 'What can I trust?'));
  renderCoverageTimeline(host);
  if (!list(report.snapshots).length) host.append(el('p', 'No snapshots were collected. Measurements are Unknown.'));
  const grid = el('div', undefined, 'coverage-grid'); host.append(grid);
  const section = (title, text) => { const item = el('div'); item.append(el('strong', title), el('p', text)); grid.append(item); };
  const absentClusters = list(report.clusters).filter(cluster => !nodes.some(n => n.cluster === cluster));
  section('Node measurements', (nodes.length ? resources.map(resource => {
    const complete = nodes.filter(n => known(metric(n, 'usage', resource)) && known(metric(n, 'capacity', resource)) && metric(n, 'capacity', resource) > 0 && metric(n, 'usage', resource) <= metric(n, 'capacity', resource)).length;
    return complete + '/' + nodes.length + ' observed nodes have usable ' + resource + ' usage and capacity at this snapshot. ';
  }).join('') : 'No node measurements at this snapshot. Capacity and node usage are Unknown. ') + (absentClusters.length ? absentClusters.length + ' expected clusters have no node records. ' : '') + 'These are sampled measurements, not a guarantee that capacity can safely be removed. Unknown usage is never shown as unused space.');
  const minutes = Math.max(0, Math.floor(Date.parse(report.end) / 60000) - Math.ceil(Date.parse(report.start) / 60000) + 1);
  const peaks = list(report.warnings).map(w => w.match(/^(.*) (CPU|memory) peak: incomplete history at (\d+) minute\(s\)/)).filter(Boolean);
  const incomplete = peaks.length || list(report.coverage).some(c => c.intervals.some(i => !i.eligible));
  section('Peak search' + (incomplete ? ' is incomplete' : ''), incomplete ? 'Some minutes were excluded because node coverage was incomplete. Selected peaks are the highest fully covered samples, not proven maxima for the entire run. See eligible minutes in coverage details.' : 'Peaks are selected from fully covered minute samples. Shorter bursts can still fall between samples or be smoothed by the measurement window.');
  const partial = workloads.some(w => resources.some(resource => !known(metric(w, 'usage', resource)) || !known(metric(w, 'requests', resource))));
  section('Workload totals' + (partial ? ' are partial' : ''), (workloads.length ? resources.map(resource => workloads.filter(w => known(metric(w, 'usage', resource))).length + '/' + workloads.length + ' observed workload records have ' + resource + ' usage; ' + workloads.filter(w => known(metric(w, 'requests', resource))).length + '/' + workloads.length + ' have requests. ').join('') : 'No workload measurements at this snapshot. Workload demand is Unknown. ') + 'Partial sums omit unknown records. Record coverage is not the percentage of resource consumption captured, and node and container accounting differ.');
  const unresolved = workloads.filter(w => (w.kind || '').toLowerCase() === 'replicaset').length;
  if (unresolved) section('Owner grouping is incomplete', unresolved + ' records retain ReplicaSet owners rather than Deployment parents. Their measured values are retained, but component demand can be split across replica sets. Saved data cannot reconstruct missing parent mappings.');
  const failures = warnings.filter(w => /query unavailable|collection unavailable|collection incomplete/.test(w));
  if (failures.length) section('Collection errors', failures.length + ' query or collection diagnostics affect coverage. Missing data is not zero; inspect details below.');
  if (peaks.length && !list(report.coverage).length) {
    const details = el('details'), summary = el('summary', 'Peak-search coverage by cluster and resource'); details.append(summary);
    details.ontoggle = () => {
      details.replaceChildren(summary);
      if (!details.open) return;
      const table = el('table'), head = el('tr'); ['Scope', 'Resource', 'Eligible minutes', 'Excluded minutes'].forEach(s => head.append(el('th', s))); table.append(head);
      peaks.forEach(p => { const row = el('tr'); [p[1], p[2], Math.max(0, minutes - Number(p[3])) + '/' + minutes, p[3]].forEach(s => row.append(el('td', s))); table.append(row); });
      const scroll = el('div', undefined, 'table-scroll'); scroll.append(table); details.append(scroll);
    };
    host.append(details);
  }
  const categories = [
    ['Missing workload measurements', /partial workload metrics|container inventory unavailable; workload totals/, 'Some saved totals are unknown. Other measured rows remain usable.'],
    ['Usage excluded from attribution', /usage placement unavailable|usage container absent|usage incarnation|multiple container incarnations/, 'Samples without a reliable node, container or identity match were excluded rather than assigned speculatively.'],
    ['Inventory or placement gaps', /runtime container inventory unavailable|placement unavailable; not classified|pod phase unavailable|owner unavailable/, 'Demand or identity metadata is incomplete; these diagnostics do not invalidate independently measured node load.'],
    ['Node or label gaps', /incomplete node metrics|node pool or SKU labels unavailable|node inventory unavailable/, 'Inspect the node coverage above. Missing enrichment and missing usage have different effects.']
  ];
  const details = el('details'), summary = el('summary', 'Diagnostics: ' + warnings.length + ' messages (grouped, not a count of bad measurements)'); details.append(summary);
  details.ontoggle = () => {
    details.replaceChildren(summary);
    if (!details.open) return;
    const groups = el('ul');
