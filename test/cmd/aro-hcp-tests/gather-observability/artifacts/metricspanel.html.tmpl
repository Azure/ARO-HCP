<html>
<head>
    <meta charset="utf-8">
    <title>{{.Title}}</title>
    <script src="https://go-echarts.github.io/go-echarts-assets/assets/echarts.min.js"></script>
    <style>
        body { font-family: 'Roboto', sans-serif; margin: 16px; padding: 0; background-color: #000; color: #fff; }
        .query-footer { max-width: 1200px; margin: 20px auto; font-family: monospace; color: #ccc; }
        .query-footer summary { cursor: pointer; font-family: sans-serif; font-size: 14px; font-weight: bold; color: #fff; }
        .query-footer pre {
            background: #222; padding: 12px; border-radius: 4px;
            overflow-x: auto; white-space: pre-wrap; color: #ccc;
        }
        .copy-btn {
            margin-left: 8px; padding: 2px 10px; cursor: pointer;
            font-size: 12px; vertical-align: middle;
            background: #333; color: #fff; border: 1px solid #555;
        }
        .no-results {
            max-width: 1200px; margin: 40px auto; text-align: center;
        }
        .no-results h2 { margin-bottom: 4px; color: #4E9AF1; font-size: 18px; }
        .no-results .subtitle { color: #888; }
        .no-results .message { margin: 40px 0; font-size: 18px; color: #999; }
        .chart-section { margin-bottom: 10px; }
        .series-controls { width: 1200px; max-width: 100%; margin: 8px auto 16px; font-size: 13px; }
        .series-toolbar { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
        .series-toolbar button, .series-toolbar input[type="search"] {
            background: #191919; color: #eee; border: 1px solid #666; border-radius: 4px; padding: 6px 10px;
        }
        .series-toolbar button { cursor: pointer; }
        .series-toolbar button:disabled { opacity: .4; cursor: default; }
        .series-toolbar input[type="search"] { width: 260px; max-width: 100%; box-sizing: border-box; }
        .series-toolbar :focus-visible { outline: 2px solid #4E9AF1; outline-offset: 2px; }
        .series-status { margin-top: 8px; color: #ccc; overflow-wrap: anywhere; }
        .series-help { margin-top: 4px; color: #999; font-size: 12px; }
        .chart-description {
            max-width: 1200px; margin: 0 auto; padding: 4px 0 0 0;
            font-size: 13px; color: #888;
        }
        .chart-warning {
            max-width: 1200px; margin: 0 auto; padding: 6px 0 0 0;
            font-size: 13px; color: #FFB300;
        }
    </style>
</head>
<body>
{{range .Charts}}
    <div class="chart-section" data-min-peak-threshold="{{.MinPeakThreshold}}"{{if eq .ChartType "faceted-stacked-area"}} data-no-slider="true"{{end}}>
    {{if .HasData}}
        {{.ChartHTML}}
    {{else}}
        <div class="no-results">
            <h2>{{.Title}}</h2>
            <p class="subtitle">Window: {{$.TimeWindow.Start}} &mdash; {{$.TimeWindow.End}}</p>
            {{if .Error}}
            <p class="message" style="color:#c62828;">Query failed: {{.Error}}</p>
            {{else}}
            <p class="message">No results returned for this query.</p>
            {{end}}
        </div>
    {{end}}
        {{if .Warning}}<div class="chart-warning">&#9888; {{.Warning}}</div>{{end}}
        {{if .Description}}<div class="chart-description">{{.Description}}</div>{{end}}
        <div class="query-footer">
            <details>
                <summary>{{if .QueryLang}}{{.QueryLang}}{{else}}PromQL{{end}}: {{.Title}}
                    <button class="copy-btn" onclick="var t=this.closest('.query-footer').querySelector('pre').textContent;navigator.clipboard.writeText(t).then(function(){event.target.textContent='Copied!';setTimeout(function(){event.target.textContent='Copy'},1500)})">Copy</button>
                </summary>
                <pre>{{.Query}}</pre>
            </details>
        </div>
    </div>
{{end}}
    <!-- workaround for spyglass cutting off page bottoms -->
    <div style="height: 30px;"></div>
<script>
(function() {
    var items = document.querySelectorAll('.item');
    for (var i = 0; i < items.length; i++) {
        var inst = echarts.getInstanceByDom(items[i]);
        if (!inst) continue;
        var section = items[i].closest('.chart-section');
        var initialThreshold = section ? parseFloat(section.getAttribute('data-min-peak-threshold')) || 0 : 0;
        var selection = initLegend(inst, items[i]);
        if (section && section.getAttribute('data-no-slider') === 'true') continue;
        initSlider(inst, items[i], initialThreshold, selection);
    }

    function initLegend(chart, chartDom) {
        var option = chart.getOption();
        var peaks = new Map();
        computePeaks(option.series || []).forEach(function(s) {
            peaks.set(s.name, Math.max(peaks.get(s.name) || 0, s.peak));
        });
        var names = Array.from(peaks.keys());
        var manual = Object.create(null);
        var threshold = -Infinity;
        names.forEach(function(name) { manual[name] = option.legend[0].selected[name] !== false; });

        var controls = document.createElement('div');
        controls.className = 'series-controls';
        controls.innerHTML = '<div class="series-toolbar">' +
            '<input type="search" placeholder="Search series labels…" aria-label="Search series labels">' +
            '<button type="button" data-action="all">Select all</button>' +
            '<button type="button" data-action="none">Deselect all</button>' +
            '<button type="button" data-action="matches">Select matches</button>' +
            '<label><input type="checkbox"> Selected only</label></div>' +
            '<div class="series-status" role="status"></div>' +
            '<div class="series-help">Search and Selected only filter the legend, not the plotted lines. Click legend labels to toggle lines; use the arrows for more labels. Lower the peak slider to reveal selected lines below the threshold.</div>';
        controls.querySelectorAll('button, input').forEach(function(control) {
            control.setAttribute('aria-controls', chartDom.id);
        });
        var deselect = controls.querySelector('[data-action="none"]');
        deselect.setAttribute('aria-label', 'Deselect all series in ' + option.title[0].text);
        chartDom.parentNode.insertBefore(controls, chartDom.nextSibling);
        // go-echarts wraps plots in a flex container; controls belong below it.
        chartDom.parentNode.style.flexDirection = 'column';
        var search = controls.querySelector('input[type="search"]');
        var only = controls.querySelector('input[type="checkbox"]');
        var status = controls.querySelector('.series-status');
        var matchesButton = controls.querySelector('[data-action="matches"]');

        function matches(name) { return name.toLowerCase().includes(search.value.trim().toLowerCase()); }
        function update(resetPage) {
            // ECharts expects an ordinary object with hasOwnProperty.
            var selected = {}, plotted = [], selectedNames = [];
            var entries = [];
            names.forEach(function(name) {
                selected[name] = manual[name] && peaks.get(name) >= threshold;
                if (manual[name]) selectedNames.push(name);
                if (selected[name]) plotted.push(name);
                if (matches(name) && (!only.checked || manual[name])) {
                    entries.push({name: name, textStyle: {fontWeight: selected[name] ? 'bold' : 'normal'}});
                }
            });
            // Keep the plotted labels on the first page, even among hundreds of
            // inactive entries. Stable sorting preserves their original order.
            entries.sort(function(a, b) { return Number(selected[b.name]) - Number(selected[a.name]); });
            var legend = {
                data: entries, selected: selected, inactiveColor: '#666', inactiveBorderColor: '#555',
                textStyle: {color: '#fff', width: 1000, overflow: 'truncate'},
                tooltip: {show: true}, pageTextStyle: {color: '#ccc'}, pageIconColor: '#4E9AF1'
            };
            if (resetPage) legend.scrollDataIndex = 0;
            chart.setOption({legend: legend});
            status.textContent = selectedNames.length + ' of ' + names.length + ' selected; ' + plotted.length + ' plotted' +
                (selectedNames.length > plotted.length ? ' (' + (selectedNames.length - plotted.length) + ' hidden by peak threshold)' : '') +
                '. ' + entries.length + ' legend matches.' +
                (plotted.length === 1 ? ' Showing: ' + plotted[0] : '') +
                (selectedNames.length === 0 ? ' No series selected — select a legend label or use Select all.' : '') +
                (entries.length === 0 ? ' Clear search or turn off Selected only to see more labels.' : '');
            matchesButton.disabled = !names.some(matches);
        }
        controls.querySelector('[data-action="all"]').onclick = function() {
            names.forEach(function(name) { manual[name] = true; }); update(true);
        };
        controls.querySelector('[data-action="none"]').onclick = function() {
            names.forEach(function(name) { manual[name] = false; }); update(true);
        };
        matchesButton.onclick = function() {
            names.forEach(function(name) { if (matches(name)) manual[name] = true; }); update(true);
        };
        search.addEventListener('input', function() { update(true); });
        only.addEventListener('change', function() { update(true); });
        chart.on('legendselectchanged', function(event) {
            manual[event.name] = event.selected[event.name];
            update(false);
        });
        update(true);
        return function(value) { threshold = value; update(true); };
    }

    function initSlider(chart, chartDom, initialThreshold, applySelection) {
        var option = chart.getOption();
        if (!option.series || option.series.length < 2) return;

        var seriesPeaks = computePeaks(option.series);
        var globalMax = Math.max.apply(null, seriesPeaks.map(function(s) { return s.peak; }));
        if (globalMax <= 0) return;

        var gridRect = chart.getModel().getComponent('grid', 0).coordinateSystem.getRect();
        var yExtent = chart.getModel().getComponent('yAxis', 0).axis.scale.getExtent();
        var yRange = yExtent[1] - yExtent[0];
        if (!isFinite(yRange) || yRange <= 0) return;

        // Pin Y axis and grid dimensions so resizing the container doesn't rescale the plot
        chart.setOption({
            yAxis: {min: yExtent[0], max: yExtent[1]},
            grid: {top: gridRect.y, height: gridRect.height}
        });

        chartDom.style.position = 'relative';

        // Vertical slider aligned with Y axis
        var slider = document.createElement('input');
        slider.type = 'range';
        slider.min = String(yExtent[0]);
        slider.max = String(yExtent[1]);
        slider.value = String(yExtent[0]);
        slider.step = String(yRange / 200);
        slider.style.cssText =
            'position:absolute;' +
            'writing-mode:vertical-lr;direction:rtl;' +
            'left:' + (gridRect.x - 50) + 'px;' +
            'top:' + gridRect.y + 'px;' +
            'height:' + gridRect.height + 'px;' +
            'width:20px;margin:0;padding:0;' +
            'cursor:ns-resize;accent-color:#F44336;opacity:0.5;z-index:10;';
        slider.title = 'Filter series by minimum peak value';
        slider.setAttribute('aria-label', slider.title);
        chartDom.appendChild(slider);

        slider.addEventListener('mouseenter', function() { this.style.opacity = '0.9'; });
        slider.addEventListener('mouseleave', function() { this.style.opacity = '0.5'; });

        // Info display above slider
        var info = document.createElement('div');
        info.style.cssText =
            'position:absolute;' +
            'left:0;top:' + (gridRect.y - 16) + 'px;' +
            'width:' + gridRect.x + 'px;' +
            'font-size:10px;color:#666;text-align:center;' +
            'white-space:nowrap;z-index:10;';
        info.textContent = seriesPeaks.length + '/' + seriesPeaks.length;
        chartDom.appendChild(info);

        function applyThreshold() {
            var threshold = parseFloat(slider.value);
            info.textContent = '≥' + formatVal(threshold);
            applySelection(threshold);

            var py = chart.convertToPixel({gridIndex: 0}, [0, threshold]);
            chart.setOption({
                graphic: {elements: [{
                    id: 'thresh',
                    type: 'line',
                    silent: true,
                    shape: {x1: gridRect.x, y1: py[1], x2: gridRect.x + gridRect.width, y2: py[1]},
                    style: {
                        stroke: '#F44336', lineDash: [4, 4], lineWidth: 1,
                        opacity: threshold > yExtent[0] ? 0.6 : 0
                    },
                    z: 100
                }]}
            });
        }

        slider.addEventListener('input', applyThreshold);

        if (initialThreshold > 0) {
            slider.value = String(Math.min(initialThreshold, yExtent[1]));
            applyThreshold();
        }
    }

    function computePeaks(series) {
        return series.map(function(s) {
            var peak = 0;
            if (s.data) {
                s.data.forEach(function(d) {
                    var val = null;
                    if (Array.isArray(d)) {
                        val = d.length >= 2 ? d[1] : null;
                    } else if (d && typeof d === 'object' && d.value) {
                        val = Array.isArray(d.value) && d.value.length >= 2 ? d.value[1] : d.value;
                    }
                    if (typeof val === 'number' && val > peak) {
                        peak = val;
                    }
                });
            }
            return {name: s.name, peak: peak};
        });
    }

    function formatVal(v) {
        if (v >= 1e9) return (v/1e9).toFixed(1) + 'G';
        if (v >= 1e6) return (v/1e6).toFixed(1) + 'M';
        if (v >= 1e3) return (v/1e3).toFixed(1) + 'k';
        if (v >= 1) return v.toFixed(2);
        if (v >= 0.01) return v.toFixed(3);
        if (v === 0) return '0';
        return v.toExponential(1);
    }
})();
</script>
</body>
</html>
