<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Resource History</title>
  <style>
    :root { color-scheme: dark; }
    * { box-sizing: border-box; }
    body { margin: 0; background: #000; color: #ddd; font: 14px/1.5 system-ui, sans-serif; }
    main { max-width: 1600px; margin: auto; padding: 16px; }
    h2 { margin: 0 0 8px; font-size: 15px; font-weight: 500; }
    p { margin: 8px 0; overflow-wrap: anywhere; } .muted, label { color: #9da7b3; }
    .panel { padding: 12px 0; margin-top: 12px; min-width: 0; }
    header { color: #888; font-size: 12px; }
    .controls { display: flex; flex-wrap: wrap; gap: 12px; align-items: end; margin: 16px 0; }
    label { display: flex; flex-direction: column; gap: 5px; min-width: 0; max-width: 100%; }
    select, button { font: inherit; color: #e6edf3; background: #21262d; border: 1px solid #484f58; border-radius: 4px; padding: 7px 10px; max-width: 100%; }
    select { min-width: 140px; } button { cursor: pointer; } button:hover { border-color: #58a6ff; } :focus-visible { outline: 2px solid #58a6ff; outline-offset: 2px; }
    .warning { border-left: 4px solid #d29922; background: #292315; padding: 12px 16px; }
    .charts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } .charts .panel { margin: 0; } .charts .panel:last-child { grid-column: 1 / -1; }
    .chart { height: 350px; width: 100%; } [hidden] { display: none !important; }
    @media (max-width: 900px) { .charts { grid-template-columns: 1fr; } }
    @media (max-width: 650px) { main { padding: 12px; } .panel { padding: 12px; } .controls > label { width: 100%; } select { width: 100%; } .chart { height: 310px; } }
  </style>
</head>
<body>
<main>
  <header id="window"></header>
  <noscript><p class="warning">JavaScript is required to explore this embedded history. No Azure credentials are needed.</p></noscript>
  <p id="history-status" class="warning" role="status"></p>
  <div id="history-content" hidden>
    <div class="controls">
      <label>Cluster<select id="cluster" aria-label="Cluster"></select></label>
      <label>Pool<select id="pool" aria-label="Pool"></select></label>
      <label>Node<select id="node" aria-label="Node"></select></label>
      <label>Display<select id="display"><option value="absolute">Absolute</option><option value="percent">% capacity</option></select></label>
      <button id="reset-zoom" type="button">Reset zoom</button>
    </div>
    <p id="chart-status" class="muted" role="status">Loading charts...</p>
    <div class="charts">
      <section class="panel"><h2>CPU</h2><div id="chart-cpu" class="chart" hidden role="img" aria-label="CPU history"></div></section>
      <section class="panel"><h2>Memory</h2><div id="chart-memory" class="chart" hidden role="img" aria-label="Memory history"></div></section>
      <section class="panel"><h2>SWIFT-NIC</h2><div id="chart-swiftNIC" class="chart" hidden role="img" aria-label="SWIFT-NIC slot history"></div></section>
    </div>
  </div>
</main>
<script id="resource-history-data" type="application/json">{{.}}</script>
<script>
'use strict';
const report = JSON.parse(document.getElementById('resource-history-data').textContent);
const $ = id => document.getElementById(id);
const list = value => value || [];
const known = value => typeof value === 'number' && Number.isFinite(value);
const history = list(report.history), resources = ['cpu', 'memory', 'swiftNIC'];
const fields = ['capacity', 'allocatable', 'usage', 'requests'];
const labels = {capacity: 'Capacity', allocatable: 'Allocatable', usage: 'Usage', requests: 'Requests'};
const colors = {capacity: '#79b8ff', allocatable: '#c4a4ef', usage: '#56d4a3', requests: '#e3b341'};
const charts = {}, legend = {Capacity: true, Allocatable: true, Usage: true, Requests: true};
let scope = {cluster: '', pool: '', node: ''}, percent = false, zoom = {start: 0, end: 100}, aggregates = {};
const format = new Intl.NumberFormat('en-US', {maximumFractionDigits: 2});
const utc = value => new Date(value).toISOString().replace('T', ' ').replace('.000Z', ' UTC');
const nodeKey = node => JSON.stringify([node.cluster, node.name]);
const unknownPool = pool => !pool || pool === 'unknown';
const poolKey = pool => JSON.stringify(unknownPool(pool) ? '' : pool);
const resourceFields = resource => fields.filter(field => resource !== 'swiftNIC' || field !== 'usage');
// The embedded report is immutable. Expand shared records once, and index
// minute-local membership rather than carrying the latest labels backwards.
for (const sample of history) {
  sample.nodes = list(sample.nodes).map(([metadata, quantities]) => {
    const values = report.quantities[quantities];
    return {...report.metadata[metadata], capacity: values[0], allocatable: values[1], usage: values[2], requests: values[3]};
  });
}
const timestamps = history.map(sample => Date.parse(sample.time));
const timeLabels = timestamps.map(utc), startTime = Date.parse(report.start), endTime = Date.parse(report.end);
const sampleIndexes = new WeakMap();
function sampleIndex(sample) {
  if (sampleIndexes.has(sample)) return sampleIndexes.get(sample);
  const index = {clusters: new Map(), nodes: new Map(), inventory: new Set()};
  for (const node of list(sample.nodes)) {
    if (!index.clusters.has(node.cluster)) index.clusters.set(node.cluster, []);
    index.clusters.get(node.cluster).push(node);
    index.nodes.set(nodeKey(node), node);
    if (node.inventory) index.inventory.add(node.cluster);
  }
  sampleIndexes.set(sample, index);
  return index;
}
const selectorNodes = list(report.metadata);
for (const sample of history) sampleIndex(sample);
delete report.metadata; delete report.quantities; delete report.messages;
let aggregateScope;
function el(tag, text) { const element = document.createElement(tag); if (text !== undefined) element.textContent = text; return element; }
function quantity(value, resource, asPercent = false) {
  if (!known(value)) return 'Data unavailable';
  return format.format(value / (!asPercent && resource === 'memory' ? 1073741824 : 1)) + (asPercent ? '%' : resource === 'memory' ? ' GiB' : resource === 'cpu' ? ' cores' : ' slots');
}
function options(select, entries, label) {
  select.replaceChildren(el('option', label)); select.firstChild.value = '';
  for (const [value, text] of entries) { const option = el('option', text); option.value = value; select.append(option); }
}
function cascade(level) {
  if (level === 'cluster') { scope.cluster = $('cluster').value; scope.pool = ''; scope.node = ''; }
  if (level === 'pool') { scope.pool = $('pool').value; scope.node = ''; }
  if (level === 'node') scope.node = $('node').value;
  if (level !== 'node') {
    const nodes = selectorNodes.filter(node => !scope.cluster || node.cluster === scope.cluster);
    if (level === 'cluster') {
      const pools = [...new Set(nodes.map(node => poolKey(node.pool)))].sort();
      options($('pool'), pools.map(pool => [pool, JSON.parse(pool) || '(unknown pool)']), 'All pools');
      $('pool').value = scope.pool;
    }
    const choices = new Map();
    for (const node of nodes) if (!scope.pool || poolKey(node.pool) === scope.pool) choices.set(nodeKey(node), scope.cluster ? node.name : node.cluster + ' / ' + node.name);
    options($('node'), [...choices].sort((a, b) => a[1].localeCompare(b[1])), 'All nodes');
    $('node').value = scope.node;
  }
  render();
}
function aggregate(sample, resource, selected = scope) {
  const clusters = selected.node ? [JSON.parse(selected.node)[0]] : selected.cluster ? [selected.cluster] : list(report.clusters);
  const index = sampleIndex(sample);
  const clusterNodes = selected.node ? [index.nodes.get(selected.node)].filter(node => node && (!selected.cluster || node.cluster === selected.cluster)) : selected.cluster ? list(index.clusters.get(selected.cluster)) : list(sample.nodes);
  // Pool labels are only evidence for this minute, never carried forward from
  // another sample. An unlabeled node could belong to the selected pool.
  const candidates = clusterNodes.filter(node => (!selected.node || nodeKey(node) === selected.node) && (!selected.pool || poolKey(node.pool) === selected.pool || unknownPool(node.pool)));
  const missingClusters = clusters.filter(cluster => !list(sample.expected).includes(cluster) || !index.inventory.has(cluster)).length;
  const missingInventory = candidates.filter(node => !node.inventory).length;
  const ambiguousPool = candidates.filter(node => selected.pool && poolKey(node.pool) !== selected.pool).length;
  const unknownSwift = resource === 'swiftNIC' ? candidates.filter(node => node.swiftAdvertised == null).length : 0;
  const excluded = resource === 'swiftNIC' ? candidates.filter(node => node.swiftAdvertised === false).length : 0;
  const requestsWithoutAdvertisement = resource === 'swiftNIC' ? candidates.filter(node => node.swiftAdvertised !== true && known(node.requests?.swiftNIC) && node.requests.swiftNIC > 0).length : 0;
  const blocked = missingClusters > 0 || missingInventory > 0 || ambiguousPool > 0;
  const noResource = resource === 'swiftNIC' && candidates.length > 0 && excluded === candidates.length && !blocked;
  const lines = {};
  for (const field of resourceFields(resource)) {
    // Advertisement determines capacity applicability, not whether assigned
    // requests exist. Request completeness includes even non-advertising nodes.
    const needsAdvertisement = resource === 'swiftNIC' && field !== 'requests';
    const relevant = candidates.filter(node => !needsAdvertisement || node.swiftAdvertised !== false);
    const measured = relevant.filter(node => node.inventory && (!selected.pool || poolKey(node.pool) === selected.pool) && (!needsAdvertisement || node.swiftAdvertised === true) && known(node[field]?.[resource]));
    const sum = measured.reduce((total, node) => total + node[field][resource], 0);
    lines[field] = {count: measured.length, total: relevant.length, value: !blocked && !(needsAdvertisement && unknownSwift > 0) && relevant.length > 0 && measured.length === relevant.length && known(sum) ? sum : null};
  }
  const capacity = lines.capacity.value;
  for (const line of Object.values(lines)) line.percent = known(line.value) && known(capacity) && capacity > 0 ? 100 * line.value / capacity : null;
  const a = lines.allocatable.value, r = lines.requests.value;
  return {time: sample.time, lines, missingClusters, missingInventory, ambiguousPool, unknownSwift, observed: candidates.length, excluded, requestsWithoutAdvertisement, noResource,
    requestRatio: known(a) && a > 0 && known(r) ? 100 * r / a : null, estimate: known(a) && known(r) ? a - r : null};
}
function tooltip(resource, index, field) {
  const sample = aggregates[resource][index], host = el('div');
  if (!sample) return host;
  const line = sample.lines[field];
  if (!line) return host;
  host.append(el('div', timeLabels[index]), el('strong', labels[field] + ': ' + quantity(percent ? line.percent : line.value, resource, percent)));
  return host;
}
function chartOption(resource) {
  const data = aggregates[resource];
  return {
    animation: false, useUTC: true, backgroundColor: 'transparent', textStyle: {color: '#e6edf3'},
    legend: {show: true, icon: 'rect', data: resourceFields(resource).map(field => labels[field]), selected: {...legend}, textStyle: {color: '#e6edf3'}, type: 'scroll'},
    grid: {left: 65, right: 22, top: 65, bottom: 85},
    tooltip: {trigger: 'item', triggerOn: 'none', confine: true, renderMode: 'html', backgroundColor: '#161b22', borderColor: '#484f58', textStyle: {color: '#e6edf3'}},
    axisPointer: {label: {formatter: params => utc(params.value)}},
    xAxis: {type: 'time', min: startTime, max: endTime, axisLabel: {hideOverlap: true, formatter: value => utc(value).slice(5, 16)}, axisPointer: {snap: true}},
    yAxis: {type: 'value', min: 0, name: percent ? '% of capacity' : resource === 'memory' ? 'GiB' : resource === 'cpu' ? 'cores' : 'slots', splitLine: {lineStyle: {color: '#30363d'}}},
    dataZoom: [{type: 'inside', ...zoom, filterMode: 'none'}, {type: 'slider', ...zoom, filterMode: 'none', bottom: 12, textStyle: {color: '#9da7b3'}, labelFormatter: value => utc(value)}],
    series: resourceFields(resource).map(field => ({id: field, name: labels[field], type: 'line', smooth: false, step: field === 'usage' ? false : 'end', connectNulls: false, showSymbol: false, symbol: 'none', triggerLineEvent: true,
      lineStyle: {color: colors[field], width: 2}, itemStyle: {color: colors[field]},
       data: data.map((sample, index) => [timestamps[index], percent ? sample.lines[field].percent : known(sample.lines[field].value) ? sample.lines[field].value / (resource === 'memory' ? 1073741824 : 1) : null])}))
  };
}
function drawCharts() {
  if (!window.echarts || !history.length) return;
  $('chart-status').hidden = true;
  for (const resource of resources) {
    $('chart-' + resource).hidden = false;
    if (!charts[resource]) {
      const chart = charts[resource] = window.echarts.init($('chart-' + resource));
      // Synchronize navigation only; ECharts groups also broadcast tooltips.
      chart.on('datazoom', event => {
        const value = event.batch?.[0] || event;
        if (known(value.start) && known(value.end)) {
          zoom = {start: value.start, end: value.end};
          for (const other of Object.values(charts)) if (other !== chart) other.dispatchAction({type: 'dataZoom', ...zoom}, {silent: true});
        }
      });
      chart.on('legendselectchanged', event => {
        Object.assign(legend, event.selected);
        for (const other of Object.values(charts)) if (other !== chart) other.dispatchAction({type: event.selected[event.name] ? 'legendSelect' : 'legendUnSelect', name: event.name}, {silent: true});
      });
      chart.on('mouseover', () => { for (const other of Object.values(charts)) if (other !== chart) other.dispatchAction({type: 'hideTip'}); });
      chart.on('mousemove', 'series.line', event => {
        // Line events have no dataIndex when symbols are disabled.
        const time = chart.convertFromPixel({xAxisIndex: 0}, event.event.offsetX);
        if (!known(time)) return;
        let low = 0, high = timestamps.length - 1;
        while (low < high) {
          const middle = Math.floor((low + high) / 2);
          if (timestamps[middle] < time) low = middle + 1; else high = middle;
        }
        const index = low > 0 && time - timestamps[low - 1] < timestamps[low] - time ? low - 1 : low;
        const field = resourceFields(resource)[event.seriesIndex], line = aggregates[resource][index].lines[field];
        if (!known(percent ? line.percent : line.value)) { chart.dispatchAction({type: 'hideTip'}); return; }
        // With no symbol element, showTip needs explicit content and position.
        chart.dispatchAction({type: 'showTip', x: event.event.offsetX, y: event.event.offsetY, tooltip: {formatter: () => tooltip(resource, index, field)}});
      });
      chart.on('mouseout', 'series.line', () => chart.dispatchAction({type: 'hideTip'}));
    }
    charts[resource].setOption(chartOption(resource));
  }
}
function render() {
  if (!history.length) return;
  percent = $('display').value === 'percent';
  const key = JSON.stringify(scope);
  if (key !== aggregateScope) {
    for (const resource of resources) aggregates[resource] = history.map(sample => aggregate(sample, resource));
    aggregateScope = key;
  }
  drawCharts();
}
$('window').textContent = utc(report.start) + ' to ' + utc(report.end);
$('history-status').textContent = 'History not recorded.';
$('history-status').hidden = history.length > 0;
$('history-content').hidden = !history.length;
options($('cluster'), list(report.clusters).map(cluster => [cluster, cluster]), 'Fleet');
$('cluster').onchange = () => cascade('cluster'); $('pool').onchange = () => cascade('pool'); $('node').onchange = () => cascade('node');
$('display').onchange = render;
$('reset-zoom').onclick = () => { zoom = {start: 0, end: 100}; if (charts.cpu) charts.cpu.dispatchAction({type: 'dataZoom', ...zoom}); };
window.addEventListener('resize', () => Object.values(charts).forEach(chart => chart.resize()));
cascade('cluster');
</script>
<script defer src="https://go-echarts.github.io/go-echarts-assets/assets/echarts.min.js" onload="drawCharts()" onerror="document.getElementById('chart-status').textContent='Chart CDN unavailable.'"></script>
</body>
</html>
