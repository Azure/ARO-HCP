digraph nodepool_create {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Node pool create · controller flow", dpi=110];
  node [shape=box, style="rounded,filled", fillcolor="#e6f0fa", color="#35648a", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.10"];
  edge [color="#536577", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  api [label="Frontend PUT node pool\nadmission: cached parent SPC, no SPNP required\nmissing SPC: internal error, no live fallback\nthen resource + Create Operation", fillcolor="#eee7fb", color="#7b59a4"];
  parent [label="Parent cluster\nClusterServiceID + DNS prefix", fillcolor="#e4f2e5", color="#4c8053"];
  create [label="NodePoolClusterServiceCreate", fillcolor="#e6f0fa", color="#35648a"];
  sp [label="CreateServiceProviderNodePool", fillcolor="#e6f0fa", color="#35648a"];
  version [label="NodePoolVersion", fillcolor="#e6f0fa", color="#35648a"];
  upgrade [label="TriggerNodePoolUpgrade\nnondeleting pool + nonempty CS ID", fillcolor="#e6f0fa", color="#35648a"];
  cs [label="Cluster Service node pool", fillcolor="#fff0da", color="#b27624"];
  resources [label="ClusterResources / ApplyDesireController\nKubernetes NodePool convergence", fillcolor="#fff0da", color="#b27624"];
  read [label="CreateNodePoolScopedReadDesires", fillcolor="#e6f0fa", color="#35648a"];
  mirror [label="ReadDesireKubernetesController", fillcolor="#e6f0fa", color="#35648a"];
  active [label="NodePoolActiveVersions", fillcolor="#e6f0fa", color="#35648a"];
  validation [label="NodePoolValidationAzureNodePool\nDiskEncryptionSetPermissionsValidation\noptional: AFEC + tag=true + OS disk encryption set\nlive nondeleting cluster / pool; provider exists", fillcolor="#e6f0fa", color="#35648a"];
  permissions [label="Azure CheckAccessV2 observation\ndiskEncryptionSets/read for both\nservice-managed and CAPZ identities\nno Azure resource mutation", fillcolor="#fff0da", color="#b27624"];
  condition [label="ServiceProviderNodePool.Status.Validations\nnamed disk-encryption-set permission condition", fillcolor="#e4f2e5", color="#4c8053"];
  op [label="OperationNodePoolCreate\nmatching operation; nondeleting; missing ID leaves CS status pending\nAND: CS status + mirrored spec/status\n+ permission condition only when applicable\nno direct installed-version gate", fillcolor="#e6f0fa", color="#35648a"];
  done [label="ARM operation terminal state", fillcolor="#e4f2e5", color="#4c8053"];
  api -> op [label="active Create operation + deadline\nindependent monitoring"];
  api -> create [label="cached + live pool: nondeleting\nID nil or empty"];
  parent -> api [label="live parent CS ID required\nbefore admission / Cosmos transaction"];
  parent -> create [label="cached parent ID nonempty"];
  api -> sp [label="missing service-provider\ndocument"];
  api -> version [label="pool Properties.Version.ID"];
  sp -> version [label="provider exists; desired version unset or differs"];
  placement -> version [label="nonempty active control-plane versions"];
  sp -> validation [label="cached provider required"];
  api -> validation [label="live node-pool intent / opt-in", style=dashed, color="#857456"];
  permissions -> validation [label="observe effective read permission", style=dashed, color="#857456"];
  validation -> condition [label="True / False / Unknown;\nSkipped removes condition"];
  condition -> op [label="applicable: absent waits; True passes;\nFalse / Unknown: fail only when condition\nAND operation age >= 30m; otherwise wait"];
  version -> upgrade [label="desired exact version"];
  cs -> create [label="GET deterministic HREF;\nadopt after linked version resolves", style=dashed, constraint=false];
  create -> cs [label="pool or linked version GET returns 404:\nattempt POST"];
  stored [label="Node pool document\nClusterServiceID", fillcolor="#e4f2e5", color="#4c8053"];
  create -> stored [label="after adapter success: Replace pool HREF\nETag conflict: reconcile again"];
  stored -> upgrade [label="confirmed pool CS ID"];
  stored -> op [label="ID enables CS status read"];
  upgrade -> cs [label="POST unless newest policy already matches"];
  manifests [label="Cluster Service parent cluster\nresource manifest endpoint", fillcolor="#fff0da", color="#b27624"];
  manifests -> resources [label="poll using parent CS ID\nand observed placement"];
  placement [label="Parent ServiceProviderCluster\nobserved placement + control-plane versions", fillcolor="#e4f2e5", color="#4c8053"];
  placement -> read [label="observed management cluster"];
  parent -> read [label="nonempty base-domain prefix"];
  stored -> read [label="nonempty pool CS ID supplies cluster ID"];
  resources -> mirror [label="observed NodePool"];
  read -> mirror [label="ReadDesire"];
  mirror -> active [label="observed version"];
  cs -> op [label="GET pool status"];
  mirror -> op [label="label values (missing = empty) + taint subset\nscaling spec\nreplicas + health (skip health at fixed zero)"];
  op -> done [label="complete or fail;\npending / observation error past deadline: fail;\nfully observed terminal result wins; see deadline table"];
  observed [label="Customer resource Status.ActiveVersions\nfull OCP versions", fillcolor="#e4f2e5", color="#4c8053"];
  active -> observed [label="separate Cosmos replace"];
  active -> version [label="observed pool versions for skew check", style=dashed, constraint=false];
  active -> upgrade [label="active list nonempty; first version nil or differs", style=dashed, color="#857456", constraint=false];
  op -> op [label="pending: poll again", style=dashed, color="#857456", constraint=false];
}
