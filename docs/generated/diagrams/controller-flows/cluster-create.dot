digraph cluster_create {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Cluster create · admission and provisioning prerequisites", dpi=110];
  node [shape=box, style="rounded,filled", fillcolor="#e6f0fa", color="#35648a", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.10"];
  edge [color="#536577", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  put [label="Frontend PUT cluster\nbest-effort collisions: cached clusters + pools\nthen Cluster + Create Operation", fillcolor="#eee7fb", color="#7b59a4"];
  sp [label="CreateServiceProviderCluster", fillcolor="#e6f0fa", color="#35648a"];
  id [label="ClusterPendingClusterServiceIDAssign\nlive Replace sets only pending ID", fillcolor="#e6f0fa", color="#35648a"];
  ver [label="InitialNormalClusterDesiredVersion\nor ForcedClusterDesiredVersion", fillcolor="#e6f0fa", color="#35648a"];
  rollout [label="Active channel pin or stored Fleet best\nPer-cluster pin / exact override: forced assignment", fillcolor="#e4f2e5", color="#4c8053"];
  place [label="Placement", fillcolor="#e6f0fa", color="#35648a"];
  fleet [label="Fleet readiness + capacity\nSee placement panel", fillcolor="#e4f2e5", color="#4c8053"];
  azure [label="Azure prerequisites panel\ndeny-assignment readiness (real FPA)\ncurrent mock-FPA grant (mock mode)", fillcolor="#e4f2e5", color="#4c8053"];
  create [label="ClusterClusterServiceCreate\ncached + live: nondeleting, confirmed ID nil or empty\nAdoption and POST require all common inputs", fillcolor="#e6f0fa", color="#35648a"];
  federation [label="Data-plane OIDC federation panel\nall required operators: target identity ensured\nlast observation, not live Azure health", fillcolor="#e4f2e5", color="#4c8053"];
  cs [label="Cluster Service cluster exists", fillcolor="#fff0da", color="#b27624"];
  put -> sp [label="missing service-provider\ndocument"];
  put -> id [label="cached: nondeleting, nil pending ID\nconfirmed ID nil or empty"];
  sp -> ver [label="normal: assign unset version from channel\nor backfill missing transition time\nforced: policy-specific gates"];
  rollout -> ver [label="normal target or provider-pin release", style=dashed];
  sp -> place [label="placement unresolved"];
  fleet -> place [label="Ready + Schedulable +\ncapacity and scaling data current"];
  place -> place [label="no fit: record condition;\nretry after 29s", style=dashed, color="#857456", constraint=false];
  sp -> azure [label="group + identity inputs"];
  id -> azure [label="pending ID enables denies"];
  id -> create [label="pending ID non-nil"];
  id -> federation [label="pending ID permits credential naming"];
  put -> federation [label="desired operator identities"];
  federation -> create [label="required before adoption / POST\nAND other prerequisites"];
  ver -> create [label="desired exact version"];
  place -> create [label="Spec.ManagementClusterResourceID"];
  azure -> create [label="mode-specific grant readiness\nAND other common prerequisites"];
  allocation [label="ClusterDNSAllocation\nnondeleting; nil confirmed ID; empty base domain\nexisting CS cluster: defer to adoption", fillcolor="#e6f0fa", color="#35648a"];
  claims [label="Fleet DNS claim\nparent zone + five-character slug\nowner = ARO ClusterUID", fillcolor="#e4f2e5", color="#4c8053"];
  place -> allocation [label="selected MC ID gates lookup\npublic zone needed only on miss"];
  id -> allocation [label="pending ID required"];
  allocation -> claims [label="persist SPC desired name first;\ncreate claim in separate reconcile"];
  claims -> allocation [label="own active claim: publish domain\nother UID or retiring claim: reselect", style=dashed];
  allocation -> create [label="new POST only: persisted prefix + base domain", style=dashed];
  shard [label="Selected management cluster\nStatus.ClusterServiceProvisionShardID", fillcolor="#e4f2e5", color="#4c8053"];
  shard -> create [label="new POST only: registered shard", style=dashed];
  sub [label="Cached subscription\nProperties.TenantId present", fillcolor="#e4f2e5", color="#4c8053"];
  sub -> allocation [label="tenant ID for existing-cluster lookup"];
  sub -> create [label="tenant ID for adoption lookup"];
  monitor [label="OperationClusterCreate\nSee convergence panel for all ten checks"];
  result [label="ARM operation: Succeeded or Failed", fillcolor="#e4f2e5", color="#4c8053"];
  put -> monitor [label="active create operation + deadline"];
  confirmed [label="Cluster document\nClusterServiceID set, pending ID cleared", fillcolor="#e4f2e5", color="#4c8053"];
  create -> confirmed [label="replace with returned HREF after adoption or POST\nETag conflict: retry adoption"];
  confirmed -> monitor [label="confirmed ID for status read"];
  cs -> monitor [label="CS status is one observation", style=dashed];
  monitor -> result [label="completion, observed failure or expiry"];
  cs -> create [label="lookup match: adopt returned HREF", style=dashed, constraint=false];
  create -> cs [label="lookup miss + POST prerequisites: create\ncheck returned ID against pending UID"];
  create -> create [label="missing prerequisite: wait", style=dashed, color="#857456", constraint=false];
}
