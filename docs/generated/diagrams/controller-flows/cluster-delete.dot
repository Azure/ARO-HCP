digraph cluster_delete {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Cluster delete · stop publishing, external teardown and record cleanup", dpi=110];
  node [shape=box, style="rounded,filled", fillcolor="#e6f0fa", color="#35648a", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.10"];
  edge [color="#536577", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  delete [label="Frontend DELETE cluster\ndeletion timestamp + Delete Operation\nchild node-pool / external-auth deletes", fillcolor="#eee7fb", color="#7b59a4"];
  resources [label="ClusterResources\nordered applyDesireRemovalChain\ndrop cascade-covered desire documents\nset selected desires to Type=Delete and wait\nManagedCluster / ingress / HostedCluster\nthen SWIFT resources, namespaces last", fillcolor="#e6f0fa", color="#35648a"];
  ingress [label="IngressServingCertificateK8sResources +\nKubeAPIServerServingCertificateK8sResources\ndelete known ApplyDesire/ReadDesire names\nno Kubernetes deletes", fillcolor="#e6f0fa", color="#35648a"];
  ordered [label="Kube-applier / HyperShift / Kubernetes\nManagedCluster → shared ingress manifests\n→ HostedCluster (NodePool cleanup)\n→ PodNetworkInstance → PodNetwork\n→ cluster namespaces\nProcess remaining owned intents at each stage\nEmpty stages pass immediately", fillcolor="#fff0da", color="#b27624"];
  stuck_pvc [label="Kubernetes: terminating control-plane namespace\nDeleting PVC held by snapshot source finalizer\n(conditional stall)", fillcolor="#fff0da", color="#b27624"];
  snapshot_cleanup [label="SnapshotPVCFinalizerCleanupController\n(mgmt-agent)", fillcolor="#e6f0fa", color="#35648a"];
  pvc_released [label="PVC snapshot finalizer released\nKubernetes can finish namespace teardown", fillcolor="#e4f2e5", color="#4c8053"];
  drained [label="ClusterResources\nafter all known stages drain:\nsweep owned orphan ReadDesires\nKAS certificate names excluded throughout", fillcolor="#e6f0fa", color="#35648a"];
  dispatch [label="ClusterClusterServiceDelete\nDispatch\nrecover pending ID before CS DELETE", fillcolor="#e6f0fa", color="#35648a"];
  cs [label="Cluster Service\ncluster DELETE and status API", fillcolor="#fff0da", color="#b27624"];
  clear [label="ClusterDeletionClusterServiceID\nClearer", fillcolor="#e6f0fa", color="#35648a"];
  federation [label="Data-plane OIDC retirement panel\nnew retirement intent requires ALL:\ncluster deletion + CS deletion stamp + nil CS ID\nexecutor clears confirmed / pending tracking", fillcolor="#e6f0fa", color="#35648a"];
  dispatch -> federation [label="ID already nil: dispatch stamp after grace", style=dashed, constraint=false];
  clear -> federation [label="CS ID nil + both timestamps\n1m reconciliation", style=dashed, color="#857456"];
  federation -> cleanup [label="zero confirmed AND pending credential IDs\nAND all other provider cleanup gates"];
  marker [label="ClusterCredentialDeletionMarker\nController", fillcolor="#e6f0fa", color="#35648a"];
  credentials [label="Credential request / revocation\ndeletion controllers", fillcolor="#e6f0fa", color="#35648a"];
  children [label="No node-pool or external-auth documents\nin live child lists", fillcolor="#e4f2e5", color="#4c8053"];
  group [label="EnsureManagedResourceGroup\npositive ManagedBy ownership required to delete\npromote owned pending ref for mock grant retention", fillcolor="#e6f0fa", color="#35648a"];
  certificates [label="KubeAPIServerTLSCertificate +\nIngressTLSCertificate\neach: clear own provider field when\nno stored ref or vault confirms absence\nread-only, no Key Vault deletes", fillcolor="#e6f0fa", color="#35648a"];
  cleanup [label="ClusterChildResourcesCleanupController\nboth timestamps + nil CS ID\nlive child lists empty\nexclude Controller docs / child subtrees\nprovider: MRG refs gone, both TLS fields nil, OIDC IDs gone\nretire stack records; keep mock grant while MRG tracked\ndesire gate skipped if placement absent / nil client\nclient lookup errors block cleanup", fillcolor="#e6f0fa", color="#35648a"];
  final [label="ClusterDeletionController\nboth timestamps AND nil CS ID\nboth TLS fields nil / eligible children gone\nAzureResources descendants gone (own subtrees excluded)\nno ApplyDesires if cached placement known\nknown placement + nil client waits\nclient lookup errors block deletion", fillcolor="#e6f0fa", color="#35648a"];
  op [label="OperationClusterDelete\nremaining document: matching owner required\ndeadline checked before normal CS guards\nbackground cleanup continues after failure", fillcolor="#e6f0fa", color="#35648a"];
  done [label="ARM Delete Operation Succeeded", fillcolor="#e4f2e5", color="#4c8053"];
  failed [label="ARM Delete Operation Failed\ndeadline: DeadlineExceeded + diagnostics\nCS status read if ID nonnil\nCS Error: converted code / message", fillcolor="#fbe4e4", color="#9b4d4d"];
  claims [label="DNSClaimCleanup\nclaim events + hourly resync\nlive-confirm owner incarnation gone\nrecord claim DeletionTimestamp; hold 7 days\nlive-recheck before ETag-guarded delete", fillcolor="#e6f0fa", color="#35648a"];
  final -> claims [label="owner removed\nclaims cleaned asynchronously", style=dashed];
  delete -> resources [label="deleting + observed placement"];
  delete -> dispatch [label="deletion timestamp set; CS dispatch not stamped\nindependent of ApplyDesire teardown"];
  delete -> op [label="Delete Operation + deadline\nindependent polling", style=dashed, color="#857456", constraint=false];
  delete -> ingress [label="deletion intent"];
  delete -> certificates [label="deletion intent"];
  certificates -> cleanup [label="both certificate fields nil"];
  certificates -> final [label="live check: both certificate fields nil"];
  ingress -> cleanup [label="owned ApplyDesires removed"];
  resources -> ordered [label="Type=Delete intents"];
  ordered -> resources [label="pending / failed deletion: retry\napply purged or already absent: remove paired read\nby scope + name before advancing", style=dashed, color="#857456"];
  ordered -> stuck_pvc [label="Namespace Delete;\nPVC may block completion"];
  stuck_pvc -> snapshot_cleanup [label="PVC add/update or\nsource VolumeSnapshot delete", style=dashed, color="#857456"];
  snapshot_cleanup -> pvc_released [label=">=1m; no cached/live snapshot\ncached PVC Update: remove only finalizer"];
  snapshot_cleanup -> snapshot_cleanup [label="grace: delayed recheck; errors: rate limit\nsnapshot remains: wait for event", style=dashed, color="#857456", constraint=false];
  pvc_released -> ordered [label="namespace deletion observed\nby kube-applier; resume", style=dashed, color="#857456", constraint=false];
  ordered -> drained [label="all stages complete"];
  drained -> cleanup [label="known intents drained; provider also checks\nremaining scoped desires when client available"];
  dispatch -> cs [label="DELETE; accept 404 only after 120s\nfrom first observed deletion"];
  dispatch -> cleanup [label="no confirmed/pending target:\nnil ID + 120s grace permits stamping"];
  dispatch -> clear [label="both timestamps set\nand nonempty confirmed ID"];
  cs -> clear [label="GetClusterStatus returns 404"];
  delete -> marker [label="mark credential children"];
  marker -> credentials [label="Status.DeletionTimestamp"];
  delete -> children [label="child cascades mark resources for deletion"];
  delete -> group [label="deleting + tracked group: GET ownership / existence"];
  clear -> cleanup [label="ClusterServiceID cleared"];
  credentials -> cleanup [label="all credential documents gone"];
  children -> cleanup [label="all node pools / external auth\ngone"];
  group -> cleanup [label="absent OR non-owned: clear both refs\nnot proof of Azure absence\n(required before provider removal)"];
  cleanup -> final [label="eligible children removed;\nindependent final gates"];
  final -> op [label="all active billing matches marked;\ncluster doc deleted"];
  cs -> op [label="both timestamps + CS ID: poll status\n404 / Ready wait for document absence"];
  op -> failed [label="document remains past deadline\nor CS Error before deadline"];
  op -> done [label="target 404: idempotent delete + child cleanup\nthen record Succeeded"];
  clear -> clear [label="external deletion pending", style=dashed, color="#857456", constraint=false];
  group -> group [label="owned: BeginDelete only with CS deletion stamp,\nnil/empty CS ID and observed state other than Deleting", style=dashed, color="#857456", constraint=false];
}
