digraph cluster_delete {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Cluster delete · stop publishing, external teardown and record cleanup", dpi=110];
  node [shape=box, style="rounded,filled", fillcolor="#e6f0fa", color="#35648a", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.10"];
  edge [color="#536577", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  delete [label="Frontend DELETE cluster\ndeletion timestamp + Delete Operation\nchild node-pool / external-auth deletes", fillcolor="#eee7fb", color="#7b59a4"];
  resources [label="ClusterResources\nordered applyDesireRemovalChain\ndrop cascade-covered desire documents\nset selected desires to Type=Delete and wait\nManagedCluster / ingress / HostedCluster\nthen SWIFT resources, namespaces last", fillcolor="#e6f0fa", color="#35648a"];
  ingress [label="IngressCertificate\ndelete known ApplyDesire/ReadDesire names\nno Kubernetes deletes", fillcolor="#e6f0fa", color="#35648a"];
  ordered [label="Kube-applier / HyperShift / Kubernetes\nManagedCluster → shared ingress manifests\n→ HostedCluster (NodePool cleanup)\n→ PodNetworkInstance → PodNetwork\n→ cluster namespaces\nWait for deletion at each stage", fillcolor="#fff0da", color="#b27624"];
  stuck_pvc [label="Kubernetes: terminating control-plane namespace\nDeleting PVC held by snapshot source finalizer\n(conditional stall)", fillcolor="#fff0da", color="#b27624"];
  snapshot_cleanup [label="SnapshotPVCFinalizerCleanupController\n(mgmt-agent)", fillcolor="#e6f0fa", color="#35648a"];
  pvc_released [label="PVC snapshot finalizer released\nKubernetes can finish namespace teardown", fillcolor="#e4f2e5", color="#4c8053"];
  drained [label="ClusterResources\npurge completed ApplyDesires + paired reads\nfinally sweep owned orphan ReadDesires", fillcolor="#e6f0fa", color="#35648a"];
  dispatch [label="ClusterClusterServiceDelete\nDispatch\nrecover pending ID before CS DELETE", fillcolor="#e6f0fa", color="#35648a"];
  cs [label="Cluster Service / external cleanup\nKubernetes and Azure resources", fillcolor="#fff0da", color="#b27624"];
  clear [label="ClusterDeletionClusterServiceID\nClearer", fillcolor="#e6f0fa", color="#35648a"];
  marker [label="ClusterCredentialDeletionMarker\nController", fillcolor="#e6f0fa", color="#35648a"];
  credentials [label="Credential request / revocation\ndeletion controllers", fillcolor="#e6f0fa", color="#35648a"];
  children [label="Node-pool and external-auth\ndeletion flows complete", fillcolor="#e4f2e5", color="#4c8053"];
  group [label="EnsureManagedResourceGroup", fillcolor="#e6f0fa", color="#35648a"];
  certificates [label="KubeAPIServerTLSCertificate +\nIngressTLSCertificate\neach: GET its own vault ref;\n404 clears that reference\nread-only, no Key Vault deletes", fillcolor="#e6f0fa", color="#35648a"];
  cleanup [label="ClusterChildResourcesCleanupController\nboth timestamps + nil CS ID; child pipelines gone\nexclude Controller docs / child subtrees\nprovider: no MRG / TLS refs / bundles\ndesire gate skipped if placement/client absent", fillcolor="#e6f0fa", color="#35648a"];
  final [label="ClusterDeletionController\nno TLS refs / bundles / eligible children\nno ApplyDesires if cached placement known\nknown placement + missing client waits", fillcolor="#e6f0fa", color="#35648a"];
  op [label="OperationClusterDelete\ndeadline checked before normal CS guards\nbackground cleanup continues after failure", fillcolor="#e6f0fa", color="#35648a"];
  done [label="ARM Delete Operation Succeeded", fillcolor="#e4f2e5", color="#4c8053"];
  failed [label="ARM Delete Operation Failed\ndeadline: InternalServerError + diagnostics\nCS Error: converted code / message", fillcolor="#fbe4e4", color="#9b4d4d"];
  schedules [label="BackupSchedule + kube-applier\nDelete-type desires remove Schedules", fillcolor="#e6f0fa", color="#35648a"];
  backups [label="BackupCleanup (mgmt-agent)\nALL: recognized terminal Backup, HC absent,\nno active transfers/restores, no opt-outs\nLive reads + pure plan + non-forced SSA", fillcolor="#e6f0fa", color="#35648a"];
  velero [label="Velero (external)\nprocess DeleteBackupRequest\ndelete Backup and associated backup data", fillcolor="#fff0da", color="#b27624"];
  retirement [label="RepositoryCleanup: retirement\nDefault repository finalizer before deletion\nALL: HC absent, no matching/unscoped\nBackups or Schedules, no active consumers,\nno storage aliases or opt-outs", fillcolor="#e6f0fa", color="#35648a"];
  handoff [label="RepositoryCleanup: durable handoff\nDelete repository; SSA immutable cleanup CR\nDefault finalizer; no ownerReference\nLive-verify intent, release repository finalizer\nHandoff only, not held for storage cleanup", fillcolor="#e6f0fa", color="#35648a"];
  drain [label="RepositoryCleanup: drain maintenance\nALL: repository name absent (any UID),\nfresh consumer/opt-out checks pass\nActive same-volume foreign work blocks\neven if current BSL differs\nRemove only associated terminal maintenance;\nterminal foreign Jobs left untouched", fillcolor="#e6f0fa", color="#35648a"];
  sweep [label="RepositoryCleanup -> Azure (direct)\nSweep exact public-Azure Kopia prefix\nNormal deletes: blobs, versions, snapshots\nInformer inventories + targeted live checks\nFresh empty blob listing", fillcolor="#fff0da", color="#b27624"];
  retained [label="Complete=True / CleanupComplete\nRetained protected tombstone; no ownerRef\nSoft-deleted history is not permanently purged\nNo Cosmos writes; not an ARM gate", fillcolor="#e4f2e5", color="#4c8053"];
  release [label="Explicit cleanup CR removal (optional)\nFresh sweep/check before finalizer release\nEnds late-writer protection", fillcolor="#e4f2e5", color="#4c8053"];
  delete -> resources [label="deletion intent"];
  delete -> dispatch [label="deletion timestamp set; CS dispatch not stamped\nindependent of ApplyDesire teardown"];
  delete -> op [label="Delete Operation + deadline\nindependent polling", style=dashed, color="#857456", constraint=false];
  delete -> ingress [label="deletion intent"];
  delete -> certificates [label="deletion intent"];
  certificates -> cleanup [label="all certificate references empty"];
  certificates -> final [label="live reference-clear gate"];
  ingress -> cleanup [label="owned ApplyDesires removed"];
  resources -> ordered [label="Type=Delete intents"];
  ordered -> resources [label="pending / failed deletion: retry\nconfirmed deletion: advance", style=dashed, color="#857456"];
  ordered -> stuck_pvc [label="Namespace Delete;\nPVC may block completion"];
  stuck_pvc -> snapshot_cleanup [label="PVC add/update or\nsource VolumeSnapshot delete", style=dashed, color="#857456"];
  snapshot_cleanup -> pvc_released [label=">=1m; no cached/live snapshot\ncached PVC Update: remove only finalizer"];
  snapshot_cleanup -> snapshot_cleanup [label="grace: delayed recheck; errors: rate limit\nsnapshot remains: wait for event", style=dashed, color="#857456", constraint=false];
  pvc_released -> ordered [label="namespace deletion observed\nby kube-applier; resume", style=dashed, color="#857456", constraint=false];
  ordered -> drained [label="all stages complete"];
  drained -> cleanup [label="owned cluster-scoped desires gone\n(required before provider removal)"];
  dispatch -> cs [label="DELETE; stamp dispatch timestamp\n404: 120s first-observed grace"];
  dispatch -> cleanup [label="no confirmed/pending target:\nnil ID + 120s grace permits stamping"];
  cs -> clear [label="GET reports not found"];
  cs -> backups [label="live HC list confirms absence\n(any HC, even terminating, blocks)"];
  delete -> schedules [label="deletion intent"];
  backups -> velero [label="SSA DeleteBackupRequest\nwithout waiting for TTL"];
  velero -> backups [label="poll pending work; Processed + Backup\nexists: delete request, recheck, retry", style=dashed, color="#857456"];
  velero -> retirement [label="all associated Backups absent"];
  schedules -> retirement [label="matching Schedules absent"];
  retirement -> handoff [label="all observed gates pass"];
  handoff -> drain [label="repository gone; durable intent remains"];
  drain -> drain [label="WaitingForRepository / Blocked /\nDrainingMaintenance: recheck", style=dashed, color="#857456", constraint=false];
  drain -> sweep [label="associated Jobs/Pods absent; no active\nforeign work; revalidate gates\nDeletingBlobs"];
  sweep -> drain [label="SweepFailed: retry with fresh checks", style=dashed, color="#857456", constraint=false];
  sweep -> retained [label="sweep + post-sweep checks pass"];
  retained -> drain [label="events + 10m completed recheck\ncatch late writers", style=dashed, color="#857456", constraint=false];
  retained -> release [label="only if explicitly requested\nkeep tombstones by default", style=dashed, color="#857456"];
  delete -> marker [label="mark credential children"];
  marker -> credentials [label="Status.DeletionTimestamp"];
  delete -> children [label="child delete operations"];
  cs -> group [label="Azure group absence observed"];
  clear -> cleanup [label="ClusterServiceID cleared"];
  credentials -> cleanup [label="all credential documents gone"];
  children -> cleanup [label="all node pools / external auth\ngone"];
  group -> cleanup [label="group references cleared\n(required before removing\nprovider doc)"];
  cleanup -> final [label="eligible children removed;\nindependent final gates"];
  final -> op [label="all active billing matches marked;\ncluster doc deleted"];
  cs -> op [label="both timestamps + CS ID: poll status\n404 / Ready wait for document absence"];
  op -> failed [label="document remains past deadline\nor CS Error before deadline"];
  op -> done [label="document absence observed"];
  clear -> clear [label="external deletion pending", style=dashed, color="#857456", constraint=false];
  group -> group [label="group still exists: observe again\n(or delete if orphaned)", style=dashed, color="#857456", constraint=false];
}
