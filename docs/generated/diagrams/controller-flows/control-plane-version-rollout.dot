digraph control_plane_version_rollout {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.6", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Control-plane versions · selection, assignment and observed progress", dpi=110];
  node [shape=box, style="rounded,filled", fillcolor="#e6f0fa", color="#35648a", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.10"];
  edge [color="#536577", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  request [label="Cluster requested channel + minor\nCluster experimental exact override / Immediate", fillcolor="#eee7fb", color="#7b59a4"];
  pin [label="Admin POST /controlplaneversionpin\nprerelease target: skip rollback-history validation\nplain x.y.z: hold / advance latest observed version\nor rollback to previous distinct Completed version\nmissing history: accept pin; syntax / release-line checks remain", fillcolor="#eee7fb", color="#7b59a4"];
  storedpin [label="ServiceProviderCluster.Spec.PinnedVersion", fillcolor="#e4f2e5", color="#4c8053"];
  fleetpin [label="Admin POST /versionrollouts/{channel}/controlplaneversionpin\nregional rollout membership snapshot\nvalidate all changes before independent ETag writes\nunchanged pins: no-op; partial failures: summary", fillcolor="#eee7fb", color="#7b59a4"];
  channelpin [label="Admin POST /versionrollouts/{channel}/pinnedversion\nETag replace one Fleet rollout", fillcolor="#eee7fb", color="#7b59a4"];
  policy [label="Fleet rollout Spec.PinnedVersion\nexact + optional threshold", fillcolor="#e4f2e5", color="#4c8053"];
  effective [label="Effective channel target\nactive channel pin → pinned exact; otherwise stored Fleet best"];
  actual [label="ActualHostedCluster controller\n→ provider Status.ControlPlaneVersionHistory\nfull observed control-plane history"];
  seed [label="ControlPlaneVersionRolloutSeeding\nnon-deleting, non-nightly clusters\nprospective discovery: separate catalog panel"];
  rollout [label="Fleet rollout: channel name + Spec.Version\nabsent legacy profile filled on Cosmos reads\nassignment consumers parse channel names", fillcolor="#e4f2e5", color="#4c8053"];
  migration [label="CosmosRolloutVersionMigration\nfive workers; 5m resync/cooldown\nonce per key/process after success\nno subscription dependency"];
  best [label="ControlPlaneVersionBestVersionSelection\ncompare graph result with optional backend channel minimum"];
  updategraph [label="OpenShift update graph\nstable offset 1; other channels offset 0\nrecency only; risk filtering is a follow-up", fillcolor="#fff0da", color="#b27624"];
  target [label="Fleet rollout Spec.BestExactVersion", fillcolor="#e4f2e5", color="#4c8053"];
  initial [label="InitialNormalClusterDesiredVersion\nMinorUpgradeNormalClusterDesiredVersion\nrequested channel; no progressive gates\nminor upgrades recheck node-pool skew"];
  normal [label="ZStreamProgressiveDesiredVersionRollout\ninitialized, non-deleting clusters\nexclude exact override and Immediate policy\ncanary → rolling; failure budget\nETag batch reservation + 60s cooldown"];
  forced [label="ForcedClusterDesiredVersion\nSRE pin precedes experimental exact version\neffective target ≥ provider threshold releases pin\nexact override needs no rollout\nImmediate: same minor; rollback only with active channel pin"];
  desired [label="Provider desired exact version\n+ DesiredVersionLastTransitionTime", fillcolor="#e4f2e5", color="#4c8053"];
  dispatch [label="ClusterClusterServiceCreate (initial)\nTriggerControlPlaneUpgrade (existing)"];
  external [label="Cluster Service / HyperShift / Kubernetes\nexternal control-plane convergence\nmanifest delivery: separate boundary panel", fillcolor="#fff0da", color="#b27624"];
  observe [label="ReadDesireKubernetesController\n→ ControlPlaneActiveVersions"];
  history [label="Provider active versions + transition times\nCompleted base + any Partial at rollback to base: still in flight", fillcolor="#e4f2e5", color="#4c8053"];
  status [label="ControlPlaneVersionStatusCollector\nupgrade maps exclude missing / deleting clusters\nreference count INCLUDES deletion; see catalog panel"];
  counts [label="Fleet status: desired / mismatched / failed\nachieved / successful\nsuccess age > 1h; mismatch timeout > 2h default", fillcolor="#e4f2e5", color="#4c8053"];
  request -> seed [label="requested channel"];
  storedpin -> seed [label="pinned minor’s channel", style=dashed];
  pin -> storedpin [label="write / clear Spec.PinnedVersion"];
  fleetpin -> storedpin [label="write / clear each selected Spec.PinnedVersion"];
  actual -> pin [label="plain x.y.z target history checks", style=dashed, constraint=false];
  actual -> fleetpin [label="changed plain x.y.z target history checks", style=dashed, constraint=false];
  desired -> fleetpin [label="channel membership", style=dashed, constraint=false];
  history -> fleetpin [label="membership fallback only", style=dashed, constraint=false];
  seed -> rollout [label="create with Spec.Version"];
  rollout -> best [label="rollout informer; independent of migration"];
  rollout -> migration [label="rollout watch / resync", style=dashed];
  migration -> rollout [label="live read + ETag replace\npersist normalized profile", constraint=false];
  updategraph -> best [label="graph selection result"];
  best -> target [label="persist changed best"];
  channelpin -> policy [label="set / clear pin; no provider write"];
  policy -> effective [label="exact set AND (no threshold OR no best OR best ≤ threshold)"];
  target -> effective [label="no exact pin or best > threshold: use stored best;\na fall to or below the threshold can reactivate a pin"];
  effective -> initial [label="nil desired or requested minor change"];
  effective -> normal [label="desired below target OR active channel pin + desired above target;\nno provider pin or its release threshold reached"];
  effective -> forced [label="pin release / Immediate", style=dashed];
  storedpin -> forced [label="pin has precedence", style=dashed];
  forced -> storedpin [label="clear on release in same provider Replace", style=dashed, constraint=false];
  request -> forced [label="optional override / Immediate", style=dashed, constraint=false];
  initial -> desired [label="normal initial/minor assignment"];
  normal -> desired [label="selected z-stream batch"];
  forced -> desired [label="forced assignment"];
  desired -> dispatch [label="plus creation / dispatch prerequisites"];
  dispatch -> external [label="POST cluster or submit upgrade policy"];
  external -> observe [label="controlPlaneVersion.history only\nno legacy history fallback"];
  external -> actual [label="ReadDesire HostedCluster mirror", style=dashed];
  observe -> history [label="record observed state"];
  history -> status [label="Completed base, Partial presence + age"];
  desired -> status [label="membership + target + age", style=dashed, constraint=false];
  status -> counts [label="persist changed counts + reference inventory"];
  history -> normal [label="recompute rollback-aware counts\nfrom provider snapshot", style=dashed, color="#857456", constraint=false];
}
