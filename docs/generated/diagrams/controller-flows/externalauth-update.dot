digraph externalauth_update {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="External auth update · controller flow", dpi=110];
  node [shape=box, style="rounded,filled", fillcolor="#e6f0fa", color="#35648a", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.10"];
  edge [color="#536577", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  api [label="Frontend PUT / PATCH external auth\ndesired state + Update Operation (atomic)\nExternalID = ARM ID; InternalID = empty\npreserve resource ClusterServiceID\nreject delete intent; reset 30m update deadline", fillcolor="#eee7fb", color="#7b59a4"];
  child [label="ExternalAuth resource\nServiceProviderProperties.ClusterServiceID\nbackend prerequisite", fillcolor="#e4f2e5", color="#4c8053"];
  dispatch [label="ExternalAuthClusterServiceUpdate\nDispatch", fillcolor="#e6f0fa", color="#35648a"];
  cs [label="Cluster Service external auth", fillcolor="#fff0da", color="#b27624"];
  op [label="OperationExternalAuthUpdate\nmatching active operation + resource ID\nnondeleting; missing CS ID waits\n+ both configuration observations", fillcolor="#e6f0fa", color="#35648a"];
  failed [label="ARM Update Failed\nexpired pending/error: DeadlineExceeded", fillcolor="#fbe4e4", color="#9b4d4d"];
  op -> failed [label="strictly after 30m persisted deadline"];
  done [label="ARM Update Operation Succeeded", fillcolor="#e4f2e5", color="#4c8053"];
  external [label="ClusterResources / ApplyDesireController\nparent HostedCluster configuration", fillcolor="#fff0da", color="#b27624"];
  mirror [label="ReadDesireKubernetesController\nexisting parent HostedCluster read", fillcolor="#e6f0fa", color="#35648a"];
  api -> dispatch [label="not deleting; config changed\n(resource ID also required)"];
  child -> dispatch [label="ID required for PATCH"];
  child -> op [label="read ID from resource\nfor Cluster Service GET"];
  api -> op [label="Operation.ExternalID locates\nresource; ActiveOperationID matches"];
  dispatch -> cs [label="PATCH on live config drift\nno persisted dispatch hash"];
  cs -> op [label="observe requested\nconfiguration"];
  op -> done [label="both configurations match\n30m deadline; no readiness check"];
  cs -> external [label="external desired configuration"];
  external -> mirror [label="observed HostedCluster spec"];
  mirror -> op [label="issuer / clients / claims /\nrules match"];
  op -> op [label="pending: observe again", style=dashed, color="#857456", constraint=false];
}
