digraph billing_lifecycle {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.65", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Billing records · incarnation, metadata repair and cutoff", dpi=110];
  node [shape=box, style="rounded,filled", fillcolor="#e6f0fa", color="#35648a", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.10"];
  edge [color="#536577", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  ready [label="Cluster: Succeeded + nonempty UID\nno BillingDocumentCosmosID", fillcolor="#e4f2e5", color="#4c8053"];
  create [label="CreateBillingDoc\ncache then live cluster / billing reads\nnew record requires configured managed RG"];
  record [label="Billing document: ID = ClusterUID\ncreation time, tenant, location, managed RG\nResources cluster link written separately", fillcolor="#e4f2e5", color="#4c8053"];
  repair [label="ReconcileBillingManagedResourceGroup\nALL cached gates: nondeleting cluster\nlink = nonempty UID, matching ARM ID\nactive billing document"];
  metadata [label="PATCH only /managedResourceGroup\ncanonical configured RG; unset clears it\nunset configuration also returns an error", fillcolor="#e4f2e5", color="#4c8053"];
  sweep [label="OrphanedBillingCleanup\nimmediate / hourly jittered sweep\nvalid document identity; active record"];
  candidate [label="Cached cluster absent OR\nconsistent UID/link identifies another record\npersist first OrphanedSince", fillcolor="#e4f2e5", color="#4c8053"];
  recovered [label="Cluster references this document\nor linkage is ambiguous\nclear existing OrphanedSince", fillcolor="#e4f2e5", color="#4c8053"];
  cutoff [label="Active-record conditional cutoff\nDeletionTime = confirmation time\nexisting cutoff is never overwritten", fillcolor="#e4f2e5", color="#4c8053"];
  delete [label="ClusterDeletionController\nnormal teardown gates pass\nMarkBillingDocumentDeleted before\ndeleting Resources cluster document"];
  external [label="External HCP Billing service\nconsumes usage and updates watermarks\nimplementation outside this checkout", fillcolor="#fff0da", color="#b27624"];
  history [label="Billing history remains\nno physical billing-document deletion", fillcolor="#e4f2e5", color="#4c8053"];
  ready -> create [label="cluster event / 60s resync"];
  create -> record [label="create if absent; then link\nretry can adopt existing document"];
  record -> repair [label="cluster / billing add-update events\n1h resync; no billing-delete adapter"];
  repair -> metadata [label="different stored representation\nserver requires absent/null deletionTime"];
  metadata -> repair [label="cache feedback / errors retry\nvalid equality: no write", style=dashed, color="#857456"];
  record -> sweep [label="billing lister snapshot", style=dashed, color="#857456"];
  sweep -> candidate [label="orphan evidence"];
  sweep -> recovered [label="present or unresolved linkage"];
  candidate -> sweep [label="recheck; preserve observation time\ninvalid identity: leave timestamp alone", style=dashed, color="#857456"];
  candidate -> cutoff [label="still orphaned for at least 24h\nserver requires absent/null deletionTime"];
  recovered -> sweep [label="later candidacy starts fresh grace", style=dashed, color="#857456"];
  delete -> cutoff [label="case-insensitive ARM ID query\npatch all active matches; no cross-container atomicity"];
  record -> external [label="usage-accounting input", style=dashed, color="#857456"];
  cutoff -> history [label="close accounting interval"];
  external -> history [label="watermarks retained by metadata/cutoff patches", style=dashed, color="#857456"];
}
