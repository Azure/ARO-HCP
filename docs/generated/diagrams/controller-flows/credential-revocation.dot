digraph credential_revocation {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.55", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Credential revocation · cancellation, external observation and ARM completion", dpi=110];
  node [shape=box, style="rounded,filled", fillcolor="#e6f0fa", color="#35648a", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.10"];
  edge [color="#536577", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];

  api [label="Frontend POST revokecredentials\nCancel active RequestCredential operations in scope\nPersist operation + cluster marker in one batch", fillcolor="#eee7fb", color="#7b59a4"];
  dispatch [label="SystemAdminCredentialDispatchRevokeCredentials\nCreate or reuse revocation, record its reference\nand set the operation to Deleting"];
  mark [label="SystemAdminCredentialRevocationMarkRequests\nStamp unmarked request documents,\nthen record CredentialsMarkedForDeletion"];
  publish [label="SystemAdminCredentialRevocationDesires\nEnsure revocation ApplyDesire and ReadDesire"];
  external [label="Management-cluster Kubernetes\nCertificateRevocationRequest status", fillcolor="#fff0da", color="#b27624"];
  complete [label="SystemAdminCredentialRevocationCompletion\nRequire BOTH persisted conditions\nSet Complete + deletion timestamp"];
  parent [label="ClusterCredentialDeletionMarkerController\nparent cluster deletion"];
  teardown [label="SystemAdminCredentialRevocationDeletion\nTear down desires, then delete revocation document"];
  poll [label="SystemAdminCredentialOperationRevokeCredentialsPoll\nStill Deleting AND reference recorded\nlive GET of the revocation"];
  result [label="ARM operation Succeeded", fillcolor="#e4f2e5", color="#4c8053"];

  api -> dispatch [label="Accepted + cluster marker matches operation"];
  dispatch -> mark [label="unmarked, nondeleting revocation"];
  dispatch -> publish [label="nondeleting revocation; cluster ID, observed\nplacement, namespace and storage client available"];
  dispatch -> poll [label="Deleting operation + reference"];
  publish -> external [label="ApplyDesireController applies intent"];
  external -> complete [label="ReadDesire mirror: PreviousCertificatesRevoked=True\nenables CertificatesRevoked=True", style=dashed];
  mark -> complete [label="CredentialsMarkedForDeletion=True"];
  parent -> teardown [label="alternative: stamp child for deletion\ncluster DELETE cancels active cluster operations", style=dashed];
  complete -> teardown [label="deletion timestamp"];
  teardown -> teardown [label="wait for SuccessfullyDeleted on applies,\npurge them, then remove reads", style=dashed];
  teardown -> poll [label="revocation document absent"];
  poll -> poll [label="document still present: wait", style=dashed];
  poll -> result [label="NotFound; clear marker on cache match,\nthen persist operation status"];
}
