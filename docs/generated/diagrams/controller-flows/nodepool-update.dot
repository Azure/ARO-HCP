digraph nodepool_update {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Node pool update · controller flow", dpi=110];
  node [shape=box, style="rounded,filled", fillcolor="#e6f0fa", color="#35648a", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.10"];
  edge [color="#536577", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  api [label="Frontend PUT / PATCH node pool\nadmission: cached SPC + SPNP\nbest-effort reject last capacity reduction to zero\nmissing provider state: internal error, no live fallback\nreset update deadline (default 90m)\nthen desired state + Update Operation", fillcolor="#eee7fb", color="#7b59a4"];
  dispatch [label="NodePoolClusterServiceUpdateDispatch\nnondeleting + nonempty CS ID\n1m per-key cooldown", fillcolor="#e6f0fa", color="#35648a"];
  version [label="NodePoolVersion\nparent provider: active control-plane versions required", fillcolor="#e6f0fa", color="#35648a"];
  upgrade [label="TriggerNodePoolUpgrade\nnondeleting pool + nonempty CS ID", fillcolor="#e6f0fa", color="#35648a"];
  cs [label="Cluster Service node pool", fillcolor="#fff0da", color="#b27624"];
  kube [label="ClusterResources / ApplyDesireController\nKubernetes NodePool convergence", fillcolor="#fff0da", color="#b27624"];
  mirror [label="ReadDesireKubernetesController", fillcolor="#e6f0fa", color="#35648a"];
  active [label="NodePoolActiveVersions", fillcolor="#e6f0fa", color="#35648a"];
  op [label="OperationNodePoolUpdate\nmatching operation + nondeleting pool\nAND: version resolution + CS status + CS spec\n+ mirrored NodePool spec/status\nno direct installed-version gate", fillcolor="#e6f0fa", color="#35648a"];
  done [label="ARM operation terminal state", fillcolor="#e4f2e5", color="#4c8053"];
  api -> dispatch [label="desired configuration"];
  api -> version [label="requested version"];
  version -> upgrade [label="desired version"];
  version -> op [label="requested = resolved; mismatch checks\nNodePoolVersion IntentFailed (see caption)"];
  cs -> dispatch [label="GET current configuration", style=dashed, color="#857456", constraint=false];
  dispatch -> cs [label="PATCH when projections differ"];
  upgrade -> cs [label="POST only if newest policy does not match"];
  manifests [label="Cluster Service parent cluster\nresource manifest endpoint", fillcolor="#fff0da", color="#b27624"];
  manifests -> kube [label="poll using parent CS ID\nand observed placement"];
  kube -> mirror [label="observed NodePool"];
  mirror -> active [label="observed version"];
  api -> op [label="UpdateOperationCompletionDeadline"];
  cs -> op [label="nonempty ID + shared GetNodePool call\nlinked version: additional GET\nmissing ID / 404: all three Updating\nCS state, exact labels and ordered taints"];
  mirror -> op [label="retained mirror: label values + taint subset, scaling\ndrain: customer override or stored CS timeout\nreplicas + health (skip health at fixed zero)"];
  op -> done [label="completion / failure checks;\npending / observation error past deadline: fail;\nfully observed terminal result wins; see deadline table"];
  observed [label="Customer resource Status.ActiveVersions\nfull OCP versions", fillcolor="#e4f2e5", color="#4c8053"];
  active -> observed [label="separate Cosmos replace"];
  active -> version [label="observed pool versions for skew check", style=dashed, constraint=false];
  active -> upgrade [label="active list nonempty;\nfirst version nil or differs from target", style=dashed, color="#857456", constraint=false];
  op -> op [label="pending: poll again", style=dashed, color="#857456", constraint=false];
}
