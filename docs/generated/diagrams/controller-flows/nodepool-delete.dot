digraph nodepool_delete {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Node pool delete · controller flow", dpi=110];
  node [shape=box, style="rounded,filled", fillcolor="#e6f0fa", color="#35648a", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.10"];
  edge [color="#536577", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  api [label="Frontend DELETE node pool\nprovisioning-state conflicts first (Deleting: 409)\nthen best-effort nondeleting cached-sibling check\nexisting deletion timestamp bypasses only that check\npreserve deletion timestamp; Delete Operation\nreset deadline: 50m or persisted override", fillcolor="#eee7fb", color="#7b59a4"];
  dispatch [label="NodePoolClusterServiceDelete\nDispatch", fillcolor="#e6f0fa", color="#35648a"];
  cs [label="Cluster Service / external \ncleanup", fillcolor="#fff0da", color="#b27624"];
  clear [label="NodePoolDeletionClusterServiceID\nClearer", fillcolor="#e6f0fa", color="#35648a"];
  resources [label="ClusterResources\nparent Cluster + provider + placement + CS ID\nsuccessful nonnil resource response\nsingle-pool deletion: omit pool manifests\nreap stale owned desires", fillcolor="#e6f0fa", color="#35648a"];
  apply [label="ApplyDesireController\nexecute explicit Delete intent\npoll while target still exists", fillcolor="#e6f0fa", color="#35648a"];
  kube [label="Management-cluster Kubernetes\nobject deletion / finalizers", fillcolor="#fff0da", color="#b27624"];
  cleanup [label="NodePoolChildResourcesCleanupController\nboth timestamps + nil CS ID\nretain controller-owned ApplyDesires /\nClusterResources-owned ReadDesires\nprovider gate: no scoped desires*\n*missing placement or nil client skips desire gate\nclient lookup errors block cleanup", fillcolor="#e6f0fa", color="#35648a"];
  final [label="NodePoolDeletionController\nno ApplyDesires* / non-controller children\n*missing parent placement bypasses desire checks;\nknown placement with nil client waits here\nclient lookup errors block deletion", fillcolor="#e6f0fa", color="#35648a"];
  op [label="OperationNodePoolDelete\nmatching owner while resource exists;\n50m default delete deadline before CS guards", fillcolor="#e6f0fa", color="#35648a"];
  done [label="ARM Delete Operation Succeeded", fillcolor="#e4f2e5", color="#4c8053"];
  failed [label="ARM Delete Operation Failed\ndeadline: DeadlineExceeded\nCS failure: InternalServerError + message", fillcolor="#fbe4e4", color="#9b4d4d"];
  api -> dispatch [label="deletion requested"];
  api -> resources [label="skip deleting node pool; reap\nintents"];
  resources -> apply [label="Type=Delete; clear apply payload\nand prior status conditions"];
  apply -> kube [label="GET target; DELETE if needed"];
  kube -> apply [label="target absent: SuccessfullyDeleted=True", style=dashed, color="#857456"];
  apply -> resources [label="observe SuccessfullyDeleted=True;\npurge ApplyDesire + paired ReadDesire", style=dashed, color="#857456", constraint=false];
  resources -> cleanup [label="owned desires gone contributes to provider gate\nAND other desires gone + timestamps + nil CS ID"];
  resources -> final [label="owned ApplyDesires gone contributes\nto all-ApplyDesires gate when placement known"];
  dispatch -> cs [label="DELETE; stamp dispatch timestamp\n404: wait through 120s first-observed grace\nparent already uninstalling also accepted"];
  dispatch -> cleanup [label="nil ID: stamp after 120s first-observed grace\n(empty nonnil ID does not pass cleanup)"];
  cs -> clear [label="GET not found"];
  clear -> cleanup [label="ClusterServiceID cleared"];
  cleanup -> final [label="remove eligible descendants;\nController documents excluded"];
  cs -> op [label="both timestamps + CS ID: status\n404 / Ready wait for document removal"];
  op -> failed [label="CS Error / RecoverableError\nor remaining document past deadline"];
  final -> op [label="node-pool document deleted"];
  op -> done [label="absence observed"];
  clear -> clear [label="external deletion pending", style=dashed, color="#857456", constraint=false];
}
