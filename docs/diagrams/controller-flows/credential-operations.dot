digraph credential_operations {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Credential operations: monitoring and internal intent", dpi=110];
  node [shape=box, style="rounded,filled", fillcolor="#e6f0fa", color="#35648a", fontname="DejaVu Sans", fontsize=12];
  edge [color="#536577", fontname="DejaVu Sans", fontsize=10];
  frontend [label="Frontend accepts operation\nissuance deadline 20m / revoke 30m\nlegacy nil deadlines unchanged", fillcolor="#eee7fb"];
  reserve [label="Accepted operation dispatcher\nreserve intended internal resource ID (ETag)\nreturn before creating internal work"];
  dispatch [label="Accepted operation with reserved ID\nget/create/adopt exact internal document\nrequest: Provisioning / revoke: Deleting"];
  monitor [label="Operation poll\nexpiry before dependencies: Failed / DeadlineExceeded\nmonitor internal state only after dispatch phase", fillcolor="#fbe7e7"];
  claim [label="Revocation internal controller\ncached then live active-owner check\ncluster ETag claim + legacy mirror\nWaitingForOtherRevocation if occupied"];
  issuance [label="Issuance internal controllers\nreject deleting requests / parent creation guard\ncontinue independently of terminal operation"];
  revoke [label="Owner-only revocation controllers\nrepeat credential deletion sweep\nCRR desires and confirmation\nwait for credential teardown"];
  deletion [label="Independent internal deletion\ntear down desires\nclear only own live reference (ETag)\ndelete internal document\nno operation reads or writes"];
  repair [label="CosmosMigration + LegacyReference\nverified legacy doc / durable Active owner\npreserve Accepted undispatched legacy intent"];
  frontend -> reserve;
  reserve -> dispatch [label="next reconcile"];
  frontend -> monitor [label="monitoring only"];
  dispatch -> claim [label="revocation, including queued"];
  dispatch -> issuance [label="credential request"];
  claim -> revoke [label="owns exclusion"];
  revoke -> deletion;
  issuance -> deletion [label="deletion requested"];
  deletion -> monitor [label="completion observation\nnever resurrect Failed", style=dashed];
  repair -> claim [label="migrate / release legacy sentinel", style=dashed];
}
