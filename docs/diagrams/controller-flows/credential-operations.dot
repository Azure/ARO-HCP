digraph credential_operations {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Credential operations: monitoring and internal intent", dpi=110];
  node [shape=box, style="rounded,filled", fillcolor="#e6f0fa", color="#35648a", fontname="DejaVu Sans", fontsize=12];
  edge [color="#536577", fontname="DejaVu Sans", fontsize=10];
  frontend [label="Frontend accepts operation\nissuance deadline 20m / revoke 30m\nrevoke: reserve same ID on operation + cluster\ncluster requestedAt = operation StartTime\nexisting transaction + cluster ETag", fillcolor="#eee7fb"];
  reserve [label="Issuance / legacy revoke dispatcher\nreserve intended internal resource ID (ETag)\nreturn before creating internal work"];
  dispatch [label="Accepted operation with reserved ID\nget/create/adopt exact internal document\nrequest: Provisioning / revoke: Deleting"];
  monitor [label="Operation poll\nexpiry before dependencies: Failed / DeadlineExceeded\nmonitor internal state only after dispatch phase", fillcolor="#fbe7e7"];
  claim [label="Revoke dispatch before new work\nlive matching cluster reservation\nwithin requestedAt + 30m and ARM deadline\nno owner election or pending queue"];
  issuance [label="Issuance internal controllers\nreject deleting requests / parent creation guard\ncontinue independently of terminal operation"];
  revoke [label="Owner-only revocation controllers\nrepeat credential deletion sweep\nCRR desires and confirmation\nwait for credential teardown"];
  deletion [label="Independent internal deletion\ntear down desires\nclear own live reference + requestedAt (ETag)\nthen delete internal document\nno operation reads, replay or acknowledgement"];
  repair [label="CosmosMigration + LegacyReference\nverified legacy doc / durable Active owner\ncopy original operation StartTime, never now\nno deadline backfill; unknown time fails safe"];
  cleanup [label="ReservationCleanup watches cluster + revocations\ncache existence first, live absence confirmation\nexisting document: always keep\nmissing >= requestedAt + 30m: fresh identity/time\nclear ref + time + matching legacy sentinel (ETag)", fillcolor="#fff2cc"];
  frontend -> reserve [label="issuance"];
  frontend -> claim [label="new revoke"];
  reserve -> dispatch [label="next reconcile"];
  frontend -> monitor [label="monitoring only"];
  claim -> dispatch [label="create/adopt reserved document"];
  dispatch -> issuance [label="credential request"];
  dispatch -> revoke [label="revocation, live owner checks"];
  revoke -> deletion;
  issuance -> deletion [label="deletion requested"];
  deletion -> monitor [label="completion observation\nnever resurrect Failed", style=dashed];
  repair -> claim [label="normalize legacy reservation", style=dashed];
  frontend -> cleanup [label="reservation lifetime", style=dashed];
}
