digraph cluster_convergence {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Cluster create · observed convergence and ARM completion", dpi=110];
  node [shape=box, style="rounded,filled", fillcolor="#e6f0fa", color="#35648a", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.10"];
  edge [color="#536577", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  cs [label="Cluster Service\nconfirmed cluster ID", fillcolor="#fff0da", color="#b27624"];
  place [label="ManagementClusterPlacementSync", fillcolor="#e6f0fa", color="#35648a"];
  resources [label="ClusterResources", fillcolor="#e6f0fa", color="#35648a"];
  ingress [label="IngressCertificate\nservice tenant + fleet vault/identity\nHostedCluster namespace", fillcolor="#e6f0fa", color="#35648a"];
  certificates [label="TLSCertificates\nbackend identity: read-only Key Vault GETs\nKAS + ingress: PendingReference -> AzureReference\noperation status = completed", fillcolor="#e6f0fa", color="#35648a"];
  read [label="CreateClusterScopedReadDesires", fillcolor="#e6f0fa", color="#35648a"];
  apply [label="ApplyDesireController", fillcolor="#e6f0fa", color="#35648a"];
  kube [label="Management-cluster Kubernetes\nHyperShift / supporting controllers", fillcolor="#fff0da", color="#b27624"];
  mirror [label="ReadDesireInformerManagingController\nReadDesireKubernetesController", fillcolor="#e6f0fa", color="#35648a"];
  props [label="ServiceProviderClusterProperties\nSync", fillcolor="#e6f0fa", color="#35648a"];
  armprops [label="ClusterPropertiesSync", fillcolor="#e6f0fa", color="#35648a"];
  role [label="IdentityRoleAssignments", fillcolor="#e6f0fa", color="#35648a"];
  azure [label="Azure role assignments\nconfirmed group + resolved identities", fillcolor="#fff0da", color="#b27624"];
  validation [label="Cluster validation controllers\nServiceProviderCluster.Status.Validations", fillcolor="#e6f0fa", color="#35648a"];
  op [label="OperationClusterCreate", fillcolor="#e6f0fa", color="#35648a"];
  done [label="ARM operation Succeeded\nActiveOperationID cleared", fillcolor="#e4f2e5", color="#4c8053"];
  uid [label="BackfillClusterUID", fillcolor="#e6f0fa", color="#35648a"];
  billing [label="CreateBillingDoc", fillcolor="#e6f0fa", color="#35648a"];
  cs -> place [label="provision shard"];
  place -> resources [label="actual management cluster"];
  cs -> resources [label="GET resource manifests"];
  place -> read [label="actual placement + cluster ID"];
  resources -> apply [label="ApplyDesires"];
  cs -> ingress [label="confirmed cluster ID"];
  cs -> certificates [label="CS creates KAS + ingress certs"];
  place -> certificates [label="hosted-cluster secrets vault"];
  certificates -> ingress [label="AzureResources.IngressCertificate\nAzureReference set"];
  place -> ingress [label="observed management cluster"];
  props -> ingress [label="HostedCluster namespace"];
  ingress -> apply [label="SPC + SecretSync ApplyDesires"];
  ingress -> mirror [label="paired ReadDesires"];
  apply -> kube [label="apply objects"];
  read -> mirror [label="ReadDesires"];
  kube -> mirror [label="observed content / absence"];
  mirror -> props [label="namespace + serving-CA content"];
  cs -> armprops [label="API / console / DNS"];
  selected [label="Selected Spec placement\nfrom prerequisites panel", fillcolor="#e4f2e5", color="#4c8053"];
  selected -> op [label="placement completion"];
  cs -> op [label="Cluster Service state"];
  mirror -> op [label="HostedCluster readiness +\nversion"];
  props -> op [label="serving CA populated"];
  armprops -> op [label="API endpoint populated"];
  role -> azure [label="GET / create missing"];
  role -> op [label="confirmed nonempty; none\npending"];
  certificates -> op [label="KAS + ingress\nAzureReference non-nil"];
  validation -> op [label="False: Provisioning + InvalidResource;\nfailure and operation each >= 5m: Failed;\nall True: ready"];
  op -> done [label="all completion checks\nsatisfied"];
  failed [label="ARM operation Failed\nselected error code", fillcolor="#fbe8e5", color="#a64f43"];
  op -> failed [label="any validation False >= 5m\nand operation age >= 5m: InvalidResource"];
  op -> failed [label="pending past deadline: selected code + reasons;\nonly InternalServerError becomes DeadlineExceeded"];
  done -> billing [label="Succeeded; billing reference\nmissing"];
  uid -> billing [label="ClusterUID available"];
  azure -> role [label="created stays pending until\nGET confirms", style=dashed, color="#857456", constraint=false];
  op -> op [label="pending: observe again", style=dashed, color="#857456", constraint=false];
  kube -> resources [label="desired manifests reapplied on\nreconciliation", style=dashed, color="#857456", constraint=false];
}
