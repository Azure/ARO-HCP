digraph version_catalog {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Version catalog - internal discovery and Resources publication", dpi=110];
  node [shape=box, style="rounded,filled", fillcolor="#e6f0fa", color="#35648a", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.10"];
  edge [color="#536577", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  graphdata [label="Cincinnati graph-data archive\nvalidated allowed profiles at/above backend floor", fillcolor="#fff0da", color="#b27624"];
  refs [label="Cached Cluster / SPC references\nrequested, desired, exact pins, overrides, active\nincludes deleting and nightly; not pin thresholds", fillcolor="#e4f2e5", color="#4c8053"];
  seed [label="ControlPlaneVersionRolloutSeeding\nindependent discovery / reference producers\nafter cache sync: immediate + 5m tickers\ncache-only events also enqueue profiles\none homogeneous typed queue; live read + retries"];
  fleet [label="Fleet: ControlPlaneVersionRollout\nSpec.Version: canonical ID + ChannelGroup\nBestExactVersion may be nil", fillcolor="#e4f2e5", color="#4c8053"];
  best [label="ControlPlaneVersionBestVersionSelection\nCincinnati exact-release selection\nexisting selector does not resolve nightly"];
  publish [label="OpenShiftVersionCatalog\ninitial cache sync + startup + rollout events\n5m delayed requeue; one regional key / worker\nadapt legacy profile without persisted backfill\nvalidate all; public floor; sort ID then channel\nAvailable = BestExactVersion != nil"];
  catalog [label="Resources: OpenShiftVersionCatalog/default\nprovider-namespace partition; regional account\nEntries: Version {ID, ChannelGroup}, Available\nincludes unresolved entries; empty results = []", fillcolor="#e4f2e5", color="#4c8053"];
  boundary [shape=note, label="Persistence only at this stage\nFrontend version GET/LIST still use Cluster Service\nNo rollout retirement controller", fillcolor="#f5f5f5", color="#777777"];
  graphdata -> seed [label="discovered profiles"];
  refs -> seed [label="referenced profiles, including below floor"];
  seed -> fleet [label="CREATE / legacy profile backfill\npreserve metadata, selection and status"];
  fleet -> best [label="profile exists", style=dashed];
  best -> fleet [label="persist changed best", constraint=false];
  fleet -> publish [label="cached full inventory\nadd / update / delete, including tombstones"];
  publish -> catalog [label="point GET; CREATE / changed ETag REPLACE\nerrors preserve previous snapshot and retry"];
  {rank=same; catalog; boundary;}
}
