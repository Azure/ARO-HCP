digraph externalauth_create {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="External auth create · controller flow", dpi=110];
  node [shape=box, style="rounded,filled", fillcolor="#e6f0fa", color="#35648a", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.10"];
  edge [color="#536577", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  api [label="Frontend PUT external auth\nresource + Create Operation (atomic)\nExternalID = ARM ID; InternalID = empty\nparent Cluster Service ID not required", fillcolor="#eee7fb", color="#7b59a4"];
  exists [label="Parent Cosmos cluster exists\nvalidation / conflict checks pass", fillcolor="#e4f2e5", color="#4c8053"];
  parent [label="Parent cluster ClusterServiceID", fillcolor="#e4f2e5", color="#4c8053"];
  create [label="ExternalAuthClusterServiceCreate\nboth incoming prerequisites required", fillcolor="#e6f0fa", color="#35648a"];
  child [label="ExternalAuth resource\nServiceProviderProperties.ClusterServiceID", fillcolor="#e4f2e5", color="#4c8053"];
  cs [label="Cluster Service external auth", fillcolor="#fff0da", color="#b27624"];
  op [label="OperationExternalAuthCreate\nmatching active operation + resource ID\n+ successful Cluster Service GET", fillcolor="#e6f0fa", color="#35648a"];
  done [label="ARM Create Operation Succeeded", fillcolor="#e4f2e5", color="#4c8053"];
  external [label="Downstream authentication rollout\nmanaged outside this poller", fillcolor="#fff0da", color="#b27624"];
  exists -> api [label="frontend prerequisites"];
  api -> create [label="not deleting; child ID absent"];
  parent -> create [label="parent ID required"];
  create -> create [label="parent ID missing: retry", style=dashed, color="#857456", constraint=false];
  create -> cs [label="adopt or POST"];
  create -> child [label="persist child ID after\nadoption / POST succeeds"];
  api -> op [label="Operation.ExternalID locates\nresource; ActiveOperationID matches"];
  child -> op [label="read ID from resource"];
  cs -> op [label="GET succeeds"];
  op -> done [label="resource existence confirms\ncompletion"];
  cs -> external [label="external desired configuration"];
  op -> op [label="pending: observe again", style=dashed, color="#857456", constraint=false];
}
