digraph control_plane_version_rollout {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.6", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Control-plane versions · selection, assignment and observed progress", dpi=110];
  node [shape=box, style="rounded,filled", fillcolor="#e6f0fa", color="#35648a", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.10"];
  edge [color="#536577", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  request [label="Cluster requested channel + minor\nSRE pin / experimental exact override / Immediate", fillcolor="#eee7fb", color="#7b59a4"];
  pin [label="Admin POST /controlplaneversionpin\nonly previous distinct Completed z-stream\nolder than latest control-plane history entry\nmissing history: reject; clear needs no history", fillcolor="#eee7fb", color="#7b59a4"];
  fleetpin [label="Admin POST /versionrollouts/{channel}/controlplaneversionpin\nregional rollout membership snapshot\nvalidate all changes before independent ETag writes\nunchanged pins: no-op; partial failures: summary", fillcolor="#eee7fb", color="#7b59a4"];
  actual [label="ActualHostedCluster controller\n→ provider Status.ActualHostedCluster\nfull observed control-plane history"];
  seed [label="ControlPlaneVersionRolloutSeeding\nnon-deleting, non-nightly clusters"];
  rollout [label="Fleet rollout: channel name + Spec.Version\nabsent legacy profile filled on Cosmos reads\nconsumers still parse channel names", fillcolor="#e4f2e5", color="#4c8053"];
  migration [label="CosmosRolloutVersionMigration\nfive workers; 5m resync/cooldown\nonce per key/process after success\nno subscription dependency"];
  best [label="ControlPlaneVersionBestVersionSelection"];
  updategraph [label="OpenShift update graph\nstable offset 1; other channels offset 0\nrecency only; risk filtering is a follow-up", fillcolor="#fff0da", color="#b27624"];
  target [label="Fleet rollout Spec.BestExactVersion", fillcolor="#e4f2e5", color="#4c8053"];
  initial [label="InitialNormalClusterDesiredVersion\nMinorUpgradeNormalClusterDesiredVersion\nrequested channel; no progressive gates\nminor upgrades recheck node-pool skew"];
  normal [label="ZStreamProgressiveDesiredVersionRollout\ninitialized, non-deleting clusters\ncanary → rolling; failure budget\nETag batch reservation + 60s cooldown"];
  forced [label="ForcedClusterDesiredVersion\nSRE pin precedes experimental exact version\npin release at UntilExactVersion; otherwise\nImmediate follows best without progressive gates"];
  desired [label="Provider desired exact version\n+ DesiredVersionLastTransitionTime", fillcolor="#e4f2e5", color="#4c8053"];
  dispatch [label="ClusterClusterServiceCreate (initial)\nTriggerControlPlaneUpgrade (existing)"];
  external [label="Cluster Service / Maestro / HyperShift\nexternal control-plane convergence", fillcolor="#fff0da", color="#b27624"];
  observe [label="ReadDesireKubernetesController\n→ ControlPlaneActiveVersions"];
  history [label="Provider active versions + transition times\nCompleted entry confirms achieved version", fillcolor="#e4f2e5", color="#4c8053"];
  status [label="ControlPlaneVersionStatusCollector\nexclude missing / deleting clusters\naggregate counts; no assignments"];
  counts [label="Fleet status: desired / mismatched / failed\nachieved / successful\nsuccess age > 1h; mismatch timeout > 2h default", fillcolor="#e4f2e5", color="#4c8053"];
  request -> seed [label="requested / pinned channels"];
  pin -> request [label="write / clear Spec.PinnedVersion"];
  fleetpin -> request [label="write / clear each selected Spec.PinnedVersion"];
  actual -> fleetpin [label="validate changed rollback pins", style=dashed, constraint=false];
  desired -> fleetpin [label="channel membership", style=dashed, constraint=false];
  history -> fleetpin [label="membership fallback only", style=dashed, constraint=false];
  seed -> rollout [label="create with Spec.Version"];
  rollout -> best [label="rollout informer; independent of migration"];
  rollout -> migration [label="rollout watch / resync", style=dashed];
  migration -> rollout [label="live read + ETag replace\npersist normalized profile", constraint=false];
  updategraph -> best [label="selectable version + configured floor"];
  best -> target [label="persist changed best"];
  target -> initial [label="nil desired or requested minor change"];
  target -> normal [label="desired set and below best;\nunpinned or pin released"];
  target -> forced [label="pin release / Immediate", style=dashed];
  request -> forced [label="optional override / Immediate", style=dashed, constraint=false];
  initial -> desired [label="normal initial/minor assignment"];
  normal -> desired [label="selected z-stream batch"];
  forced -> desired [label="forced assignment"];
  desired -> dispatch [label="plus creation / dispatch prerequisites"];
  dispatch -> external [label="POST cluster or submit upgrade policy"];
  external -> observe [label="mirrored HostedCluster history"];
  external -> actual [label="ReadDesire HostedCluster mirror", style=dashed];
  actual -> pin [label="validate rollback target", style=dashed, constraint=false];
  observe -> history [label="record observed state"];
  history -> status [label="completed version + age"];
  desired -> status [label="membership + target + age", style=dashed, constraint=false];
  status -> counts [label="persist only changed aggregates"];
  history -> normal [label="recompute decision counts\nfrom provider snapshot", style=dashed, color="#857456", constraint=false];
}
