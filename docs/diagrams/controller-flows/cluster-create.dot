digraph cluster_create {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Cluster create · admission and provisioning prerequisites", dpi=110];
  node [shape=box, style="rounded,filled", fillcolor="#e6f0fa", color="#35648a", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.10"];
  edge [color="#536577", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  put [label="Frontend PUT cluster\nCluster + Create Operation", fillcolor="#eee7fb", color="#7b59a4"];
  sp [label="CreateServiceProviderCluster", fillcolor="#e6f0fa", color="#35648a"];
  id [label="ClusterPendingClusterServiceID\nAssign", fillcolor="#e6f0fa", color="#35648a"];
  ver [label="ControlPlaneDesiredVersion", fillcolor="#e6f0fa", color="#35648a"];
  place [label="Placement", fillcolor="#e6f0fa", color="#35648a"];
  fleet [label="Fleet readiness + capacity\nSee placement panel", fillcolor="#e4f2e5", color="#4c8053"];
  azure [label="Azure prerequisites panel\nconfirmed group + deny assignments", fillcolor="#e4f2e5", color="#4c8053"];
  create [label="ClusterClusterServiceCreate", fillcolor="#e6f0fa", color="#35648a"];
  cs [label="Cluster Service cluster exists\nClusterServiceID confirmed\nContinue in convergence panel", fillcolor="#e4f2e5", color="#4c8053"];
  put -> sp [label="missing service-provider\ndocument"];
  put -> id [label="missing pending/confirmed ID"];
  sp -> ver [label="customer version + channel"];
  sp -> place [label="placement unresolved"];
  fleet -> place [label="Ready + schedulable +\ncurrent capacity"];
  place -> place [label="no fit: record condition;\nretry after 29s", style=dashed, color="#857456", constraint=false];
  sp -> azure [label="group + identity inputs"];
  id -> azure [label="pending ID enables denies"];
  id -> create [label="pending ID"];
  ver -> create [label="desired exact version"];
  place -> create [label="Spec.ManagementClusterResourceID"];
  azure -> create [label="deny precondition if enabled"];
  create -> cs [label="adopt or POST; persist ID"];
  create -> create [label="missing prerequisite: wait", style=dashed, color="#857456", constraint=false];
}
